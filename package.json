{
  "name": "yauum-astro",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-assets.mjs",
    "predev": "npm run sync",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "prebuild": "npm run sync && node scripts/ensure-full-git-history.mjs",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && npm run i18n",
    "i18n": "node scripts/i18n/translate.mjs && node scripts/i18n/localize-links.mjs && node scripts/i18n/sitemap.mjs",
    "postbuild": "node scripts/check-titles.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "deploy": "npm run build && wrangler deploy",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.1.3",
    "astro-compress": "^2.4.3",
    "marked": "^16.0.0",
    "node-html-parser": "^9.0.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3",
    "wrangler": "^4.0.0"
  }
}