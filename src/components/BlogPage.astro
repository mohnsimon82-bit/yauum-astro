---
/**
 * Blog 页面组件：/blog/（第 1 页）与 /blog/page/N/（后续页）共用。
 *
 * 文章数据在 src/lib/articles.ts（新文章加一条即可；每页篇数 = PAGE_SIZE）。
 * 第 1 页的 SEO 用 seo.ts 的 /blog/ 条目；第 N 页复用其 OG 图等字段，
 * 仅覆盖 title / path / breadcrumb（自指 canonical）。
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import InquirySection from "../components/InquirySection.astro";
import ViewCounter from "../components/ViewCounter.astro";
import { SEO, getSeo, breadcrumb, type SeoData } from "../lib/seo";
import {
  articles,
  articlesInCategory,
  articlesOnPage,
  categories,
  categoryHref,
  pageHref,
  totalPages,
  PAGE_SIZE,
} from "../lib/articles";
import "../styles/pages/blog.css";

interface Props {
  /** 页码（1 起；分类页无分页，固定第 1 页） */
  page?: number;
  /** 分类 slug（空 = 全部文章） */
  category?: string;
}

const { page = 1, category = "" } = Astro.props;
const activeCategory = category ? categories.find((c) => c.slug === category) : undefined;

/** 当前列表的数据源：分类页取该分类，首页取全部 */
const source = activeCategory ? articlesInCategory(activeCategory.slug) : articles;
const pageArticles = activeCategory ? source : articlesOnPage(page);
const pageCount = activeCategory ? 1 : totalPages;

const seo: SeoData = activeCategory
  ? {
      ...SEO["/blog/"],
      title: `${activeCategory.label} Articles | Yauum`,
      path: categoryHref(activeCategory.slug),
      jsonLd: [
        breadcrumb([
          ["Home", "/"],
          ["Blog", "/blog/"],
          [activeCategory.label, categoryHref(activeCategory.slug)],
        ]),
      ],
    }
  : page === 1
    ? getSeo("/blog/")
    : {
        ...SEO["/blog/"],
        title: `Blog – Page ${page} | Yauum`,
        path: `/blog/page/${page}/`,
        jsonLd: [
          breadcrumb([
            ["Home", "/"],
            ["Blog", "/blog/"],
            [`Page ${page}`, `/blog/page/${page}/`],
          ]),
        ],
      };
---

<BaseLayout seo={seo}>
  <section class="standard-hero">
    <div class="industrial-grid" aria-hidden="true"></div>
    <div class="shell standard-hero-inner">
      <p class="kicker kicker-accent">Manufacturing insights</p>
      <h1>Blog</h1>
      <p>Practical guidance for buyers developing custom apparel: product development, fabric and workmanship, decoration, private label, quality and packing.</p>
      <a class="button button-accent" href="/contact-us/">Send a project brief</a>
    </div>
  </section>

  <section class="section section-surface">
    <div class="shell">
      <div class="section-head">
        <div>
          <p class="kicker">01 / Articles</p>
          <nav class="blog-cats" aria-label="Article categories">
            <a
              class:list={["blog-cat", !activeCategory && "is-current"]}
              href="/blog/"
              aria-current={!activeCategory ? "page" : undefined}
            >All <span>{articles.length}</span></a>
            {categories.map((cat) => (
              <a
                class:list={["blog-cat", activeCategory?.slug === cat.slug && "is-current"]}
                href={categoryHref(cat.slug)}
                aria-current={activeCategory?.slug === cat.slug ? "page" : undefined}
              >{cat.label} <span>{cat.count}</span></a>
            ))}
          </nav>
        </div>
      </div>
      <div class="blog-list">
        {pageArticles.map((article, index) => (
          <a class="blog-entry" href={article.route}>
            <span class="blog-entry-media">
              <img
                src={SEO[article.route].ogImage}
                alt={SEO[article.route].ogImageAlt}
                width={SEO[article.route].ogImageWidth}
                height={SEO[article.route].ogImageHeight}
                loading="lazy"
                decoding="async"
              />
            </span>
            <span class="blog-entry-copy">
              <strong>{article.title}</strong>
              <span class="blog-entry-desc">{article.description}</span>
              <span class="blog-entry-meta">
                <span>{String((activeCategory ? 0 : (page - 1) * PAGE_SIZE) + index + 1).padStart(2, "0")} / {article.tag}</span>
                <time datetime={article.date}>{article.dateLabel}</time>
                <span class="blog-entry-views" data-views-for={article.route}></span>
              </span>
            </span>
            <span class="blog-entry-go" aria-hidden="true">Read the guide →</span>
          </a>
        ))}
      </div>

      {!activeCategory && pageCount > 1 && (
        <nav class="blog-pager" aria-label="Blog pages">
          {page > 1 ? (
            <a class="blog-pager-step" href={pageHref(page - 1)}>← Newer</a>
          ) : (
            <span class="blog-pager-step is-disabled">← Newer</span>
          )}
          <span class="blog-pager-nums">
            {Array.from({ length: pageCount }, (_, i) => i + 1).map((n) =>
              n === page ? (
                <span class="blog-pager-num is-current" aria-current="page">{n}</span>
              ) : (
                <a class="blog-pager-num" href={pageHref(n)}>{n}</a>
              ),
            )}
          </span>
          {page < pageCount ? (
            <a class="blog-pager-step" href={pageHref(page + 1)}>Older →</a>
          ) : (
            <span class="blog-pager-step is-disabled">Older →</span>
          )}
        </nav>
      )}
    </div>
  </section>

  <InquirySection
    product="Blog"
    id="inquiry"
    odId="inquiry-conversion"
    band="band-alt"
    kicker="02 / Start an inquiry"
    title="Send the Product Details That Shape a Useful Review."
    ctaLabel="Send project details"
  />

  <ViewCounter />
</BaseLayout>
