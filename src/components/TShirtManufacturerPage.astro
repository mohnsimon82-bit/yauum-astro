---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { WebsitePage } from "../lib/content";

interface Props {
  page: WebsitePage;
}

const { page } = Astro.props;

const styles = [
  ["01", "Oversized and heavyweight", "Body width, shoulder position, sleeve volume, fabric body, and finish are reviewed together.", "Oversized heavyweight tee, full front view"],
  ["02", "Classic and regular fit", "A dependable base for everyday retail, wholesale, and private label programs.", "Regular-fit tee, full front view"],
  ["03", "Boxy and drop shoulder", "Shoulder proportion, armhole depth, body length, and sleeve balance shape the silhouette.", "Boxy drop-shoulder tee, full front view"],
  ["04", "Long-sleeve and specialty", "Wash, graphic, printed, embroidered, and puff-print directions are reviewed per brief.", "Long-sleeve tee, full front view"],
];

const fabrics = [
  ["01", "Cotton and blended fabrics", "Review fiber composition, knit structure, hand feel, stretch, care, and intended use."],
  ["02", "GSM and fabric weight", "Confirm lightweight, midweight, or heavyweight direction with the selected fabric."],
  ["03", "Fit and size grading", "Lock chest, shoulder, body, sleeve, and armhole measurements across the size run."],
  ["04", "Neckline and construction", "Review collar shape, rib recovery, seams, reinforcement, and finishing details."],
];

const branding = [
  ["01", "Decoration method selection", "Artwork format, technique, colors, size, placement, fabric, and quantity guide the review."],
  ["02", "Embroidery and specialty detail", "Scale, density, appearance, and attachment are checked when the method suits the product."],
  ["03", "Neck, care, and size labels", "Confirm content, dimensions, material, placement, and attachment for each label."],
  ["04", "Hangtags, stickers, and codes", "Add buyer-supplied hangtags, stickers, barcodes, packaging bags, and carton marks."],
];

const process = [
  ["01", "Confirm the brief", "Share product direction, quantity, size split, references, fabric, artwork, packing, destination, and timing."],
  ["02", "Review materials and details", "Align fabric, color, hand feel, measurements, stitching, decoration, labels, and packing."],
  ["03", "Develop the sample", "Review fit, key measurements, fabric behavior, workmanship, branding, and overall appearance."],
  ["04", "Approve the reference", "Record revisions and approve the sample and specification before bulk production."],
  ["05", "Produce, check, and pack", "Follow the approved reference through production, inspection, packing, and shipment preparation."],
];

const quality = [
  ["01", "Fabric, color, and measurements", "Check shrinkage, color variation, surface condition, neckline, rib recovery, and size consistency."],
  ["02", "Stitching and decoration", "Review seams, workmanship, print or embroidery placement, sharpness, and appearance."],
  ["03", "Labels and quantities", "Verify label type, size, attachment, unit count, barcode, and order information."],
  ["04", "Packing and shipment", "Confirm folding, individual packaging, carton marks, inspection photos, and document support."],
];

const faqs = [
  ["What T-shirt styles can I customize?", "Style directions can include basic, fit-driven, wash, graphic, printed, and embroidered directions. The final pattern and measurements are confirmed during project review and sampling."],
  ["Which fabric and GSM should I choose?", "The choice depends on fit, season, hand feel, drape, surface, decoration, shrinkage expectations, and intended use. GSM is confirmed with the selected fabric during sampling."],
  ["Can I add printing or embroidery?", "Decoration methods are project-dependent. Send the file format, intended technique, colors, artwork size, and placement so the suitable option can be reviewed."],
  ["Can you add custom labels or hangtags?", "Private label details can include woven main labels, neck labels, size labels, care labels, hangtags, stickers, barcodes, packaging bags, and carton marks when specified in the order."],
  ["What is the MOQ?", "MOQ depends on the product specification, decoration method, color and size breakdown, and order requirements. Confirm the quantity before sampling or production."],
  ["Can I order a sample first?", "Yes. The workflow is sample-first. Sample time, cost, and revision terms are set per project after materials and details are confirmed."],
  ["What information is needed for a quotation?", "Send the product category, quantity and size split, references, fabric composition and target GSM, color and hand feel, artwork, label and packaging files, destination, and timing."],
  ["How are finished T-shirts checked and packed?", "Checks follow the approved sample and can cover measurements, fabric, color, construction, decoration, labels, quantities, and packing specifications."],
];
---

<BaseLayout
  title="Custom T-Shirt Manufacturer for Private Label Brands | YAUUM"
  description="Custom T-shirt manufacturing for private label brands, wholesalers, retailers, and e-commerce sellers. Review styles, fabrics, sampling, branding, quality checks, and packing."
  canonical={page.url}
>
  <div class="tshirt-page">
    <section class="tshirt-hero" aria-labelledby="tshirt-title">
      <div class="tshirt-shell tshirt-hero-grid">
        <div class="tshirt-hero-copy">
          <p class="tshirt-kicker">B2B / OEM–ODM / PRIVATE LABEL</p>
          <h1 id="tshirt-title">Custom T-Shirt Manufacturer for Private Label Brands</h1>
          <p class="tshirt-hero-lead">Develop a T-shirt from silhouette, fabric weight, measurements, artwork, labels, sample approval, and bulk references.</p>
          <div class="tshirt-actions">
            <a class="tshirt-button tshirt-button-accent" href="/contact-us/">Start your T-shirt project</a>
            <a class="tshirt-text-link" href="#tshirt-styles">Explore styles</a>
          </div>
          <div class="tshirt-hero-signals" aria-label="Project principles">
            <span><strong>01</strong> Sample-first development</span>
            <span><strong>02</strong> Project-confirmed details</span>
            <span><strong>03</strong> Private label finishing</span>
          </div>
        </div>
        <div class="tshirt-placeholder tshirt-hero-placeholder" role="img" aria-label="Pending image slot for a full T-shirt product photo">
          <span>PENDING</span>
          <strong>T-shirt product reference</strong>
          <small>Needed: a verified full-garment T-shirt photo</small>
        </div>
      </div>
    </section>

    <nav class="tshirt-rail" aria-label="T-shirt page sections">
      <div class="tshirt-shell tshirt-rail-grid">
        <a href="#tshirt-styles">Styles</a>
        <a href="#tshirt-fabrics">Fabric and fit</a>
        <a href="#tshirt-branding">Branding</a>
        <a href="#tshirt-process">Process</a>
        <a href="#tshirt-quality">Quality</a>
        <a href="#tshirt-faq">FAQ</a>
      </div>
    </nav>

    <section class="tshirt-section tshirt-section-light" id="tshirt-styles" aria-labelledby="styles-title">
      <div class="tshirt-shell">
        <div class="tshirt-section-heading">
          <div>
            <p class="tshirt-kicker tshirt-kicker-dark">01 / PRODUCT STYLES</p>
            <h2 id="styles-title">Custom T-Shirt Styles We Manufacture</h2>
          </div>
          <p>The style groups are development directions for inquiry and sampling, not a fixed stock catalog. The final pattern, measurements, fabric, and finishing are confirmed for each project.</p>
        </div>
        <div class="tshirt-card-grid tshirt-card-grid-four">
          {styles.map(([number, title, description, shot]) => (
            <article class="tshirt-line-card">
              <div class="tshirt-card-media" role="img" aria-label={`Pending image slot: ${shot}`}>
                <span>PENDING</span>
                <small>{shot}</small>
              </div>
              <span class="tshirt-card-number">{number}</span>
              <h3>{title}</h3>
              <p>{description}</p>
            </article>
          ))}
        </div>
        <div class="tshirt-media-row">
          <div class="tshirt-media-note tshirt-media-note-solo">
            <p class="tshirt-kicker tshirt-kicker-dark">BUYER CHECK</p>
            <p>Show the silhouette, size range, color direction, and decoration that should be reviewed first.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="tshirt-section tshirt-section-ink" id="tshirt-fabrics" aria-labelledby="fabrics-title">
      <div class="tshirt-shell">
        <div class="tshirt-section-heading">
          <div>
            <p class="tshirt-kicker">02 / MATERIAL AND FIT</p>
            <h2 id="fabrics-title">T-Shirt Fabrics, GSM, Fits, and Construction Options</h2>
          </div>
          <p>Fabric, fit, and construction are reviewed together. Development directions may include cotton and blended jerseys, polyester knits, mesh, interlock, rib, linen blends, washed fabrics, and heavyweight knits.</p>
        </div>
        <div class="tshirt-card-grid tshirt-card-grid-four">
          {fabrics.map(([number, title, description]) => (
            <article class="tshirt-line-card">
              <span class="tshirt-card-number">{number}</span>
              <h3>{title}</h3>
              <p>{description}</p>
            </article>
          ))}
        </div>
        <div class="tshirt-media-row tshirt-fabric-media">
          <div class="tshirt-placeholder" role="img" aria-label="Pending image slot for T-shirt fabric and GSM reference">
            <span>PENDING</span>
            <strong>Fabric and GSM reference</strong>
            <small>Needed: jersey face and reverse views, plus a verified GSM swatch comparison</small>
          </div>
          <div class="tshirt-placeholder" role="img" aria-label="Pending image slot for T-shirt construction details">
            <span>PENDING</span>
            <strong>Construction details</strong>
            <small>Needed: neckline rib, shoulder seam, and sleeve hem close-ups</small>
          </div>
        </div>
        <div class="tshirt-quote">GSM is confirmed with the selected fabric. Fiber composition, knit structure, color, hand feel, shrinkage, and decoration compatibility remain project-specific.</div>
      </div>
    </section>

    <section class="tshirt-section tshirt-section-light" id="tshirt-branding" aria-labelledby="branding-title">
      <div class="tshirt-shell">
        <div class="tshirt-section-heading">
          <div>
            <p class="tshirt-kicker tshirt-kicker-dark">03 / DECORATION AND PRIVATE LABEL</p>
            <h2 id="branding-title">Printing, Embroidery, and Private Label Options</h2>
          </div>
          <p>Decoration and brand finishing are specified with the order. The suitable method depends on artwork, fabric, placement, quantity, and required appearance.</p>
        </div>
        <div class="tshirt-card-grid tshirt-card-grid-four">
          {branding.map(([number, title, description]) => (
            <article class="tshirt-line-card">
              <span class="tshirt-card-number">{number}</span>
              <h3>{title}</h3>
              <p>{description}</p>
            </article>
          ))}
        </div>
        <div class="tshirt-media-row tshirt-media-row-reverse">
          <div class="tshirt-media-note">
            <p class="tshirt-kicker tshirt-kicker-dark">ARTWORK INPUTS</p>
            <p>Send file format, intended technique, colors, artwork size, and placement with the inquiry. Final suitability is confirmed before sampling.</p>
          </div>
          <div class="tshirt-media-pair">
            <figure class="tshirt-photo">
              <img src="/uploads/t-shirt-manufacturer/branding-screen-printing-line.webp" width="1600" height="1067" alt="Carousel screen-printing line set up for garment printing in the production workshop" loading="lazy" decoding="async" />
              <figcaption>Screen-printing line, production workshop</figcaption>
            </figure>
            <div class="tshirt-placeholder" role="img" aria-label="Pending image slot for embroidery, label, and hangtag examples">
              <span>PENDING</span>
              <strong>Labels and hangtags</strong>
              <small>Needed: neck label, care label, size label, hangtag, sticker, and barcode examples</small>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="tshirt-section tshirt-section-ink" id="tshirt-process" aria-labelledby="process-title">
      <div class="tshirt-shell">
        <div class="tshirt-section-heading tshirt-section-heading-narrow">
          <div>
            <p class="tshirt-kicker">04 / MOQ, SAMPLING, AND BULK</p>
            <h2 id="process-title">T-Shirt MOQ, Sampling, and Bulk Production Process</h2>
          </div>
          <p>Sampling time, sample cost, revision terms, MOQ, and the bulk timeline are confirmed according to the product specifications and order requirements.</p>
        </div>
        <ol class="tshirt-process-list">
          {process.map(([number, title, description]) => (
            <li>
              <span class="tshirt-process-number">{number}</span>
              <div><h3>{title}</h3><p>{description}</p></div>
            </li>
          ))}
        </ol>
        <div class="tshirt-workflow">
          <figure class="tshirt-photo">
            <img src="/uploads/t-shirt-manufacturer/process-pattern-sampling.webp" width="1600" height="1067" alt="Paper patterns and sample garments laid out on the pattern and sampling worktable" loading="lazy" decoding="async" />
            <figcaption>Pattern and sampling</figcaption>
          </figure>
          <figure class="tshirt-photo">
            <img src="/uploads/t-shirt-manufacturer/process-bulk-cutting.webp" width="1600" height="1067" alt="Layered fabric being cut into garment panels on the cutting table" loading="lazy" decoding="async" />
            <figcaption>Bulk cutting</figcaption>
          </figure>
          <figure class="tshirt-photo">
            <img src="/uploads/t-shirt-manufacturer/process-sewing-line.webp" width="1600" height="1067" alt="Sewing operators working along the garment production line" loading="lazy" decoding="async" />
            <figcaption>Sewing line</figcaption>
          </figure>
          <figure class="tshirt-photo">
            <img src="/uploads/t-shirt-manufacturer/process-packing.webp" width="1600" height="1067" alt="Folded garments bagged and bundled on the packing worktable" loading="lazy" decoding="async" />
            <figcaption>Packing</figcaption>
          </figure>
        </div>
        <div class="tshirt-process-note">MOQ and production lead time should be confirmed after the product, materials, decoration, quantity, revisions, packing, and destination are understood.</div>
      </div>
    </section>

    <section class="tshirt-section tshirt-section-light" id="tshirt-quality" aria-labelledby="quality-title">
      <div class="tshirt-shell">
        <div class="tshirt-section-heading">
          <div>
            <p class="tshirt-kicker tshirt-kicker-dark">05 / QUALITY AND HANDOFF</p>
            <h2 id="quality-title">Quality Control, Packing, and Shipping Preparation</h2>
          </div>
          <p>Quality and packing points are connected to the approved sample and order specification. Acceptance rules and tolerances are agreed per order.</p>
        </div>
        <div class="tshirt-card-grid tshirt-card-grid-two">
          {quality.map(([number, title, description]) => (
            <article class="tshirt-line-card">
              <span class="tshirt-card-number">{number}</span>
              <h3>{title}</h3>
              <p>{description}</p>
            </article>
          ))}
        </div>
        <div class="tshirt-quality-media">
          <figure class="tshirt-photo">
            <img src="/uploads/t-shirt-manufacturer/quality-finishing-ironing.webp" width="1600" height="1067" alt="Garments being steam-ironed and finished at the finishing station" loading="lazy" decoding="async" />
            <figcaption>Finishing and ironing</figcaption>
          </figure>
          <figure class="tshirt-photo">
            <img src="/uploads/t-shirt-manufacturer/quality-storage-cartons.webp" width="1600" height="1067" alt="Packing cartons and fabric rolls stored on warehouse shelving" loading="lazy" decoding="async" />
            <figcaption>Cartons and storage</figcaption>
          </figure>
          <div class="tshirt-placeholder" role="img" aria-label="Pending image slot for measurement and label inspection evidence">
            <span>PENDING</span>
            <strong>Measurement and label checks</strong>
            <small>Needed: size measurement, color and print check, and label verification photos</small>
          </div>
        </div>
      </div>
    </section>

    <section class="tshirt-section tshirt-section-ink" aria-labelledby="why-title">
      <div class="tshirt-shell tshirt-proof-layout">
        <div>
          <p class="tshirt-kicker">06 / WORKING WITH YAUUM</p>
          <h2 id="why-title">Why Work With YAUUM as Your T-Shirt Manufacturer</h2>
          <p class="tshirt-section-lead">The workflow connects product definition, material review, sampling, revision, approval, bulk production, quality checks, packing, and shipment preparation.</p>
        </div>
        <div class="tshirt-proof-list">
          <article><span>01</span><h3>A structured product development process</h3><p>Each stage creates a reference for the next stage.</p></article>
          <article><span>02</span><h3>One approved reference for sampling and bulk</h3><p>Bulk production follows the approved sample and specification.</p></article>
          <article><span>03</span><h3>Production and packing records buyers can review</h3><p>Photos and records can be requested by project stage.</p></article>
          <article><span>04</span><h3>Verified company and factory information</h3><p>Publish company facts only after supporting information is confirmed.</p></article>
        </div>
      </div>
      <div class="tshirt-shell tshirt-proof-media">
        <figure class="tshirt-photo tshirt-proof-photo">
          <img src="/uploads/t-shirt-manufacturer/showroom-tshirt-samples.webp" width="1600" height="1067" alt="Finished T-shirts in multiple colors displayed on rails in the sample showroom" loading="lazy" decoding="async" />
          <figcaption>Sample T-shirts on display in the showroom</figcaption>
        </figure>
      </div>
    </section>

    <section class="tshirt-section tshirt-section-light" id="tshirt-faq" aria-labelledby="faq-title">
      <div class="tshirt-shell">
        <div class="tshirt-section-heading tshirt-section-heading-narrow">
          <div>
            <p class="tshirt-kicker tshirt-kicker-dark">07 / BUYER QUESTIONS</p>
            <h2 id="faq-title">Common Questions Before Ordering Custom T-Shirts</h2>
          </div>
          <p>Start with the questions that shape fabric, sampling, branding, quantity, quality, and delivery decisions.</p>
        </div>
        <div class="tshirt-faq-list">
          {faqs.map(([question, answer]) => (
            <article>
              <h3>{question}</h3>
              <p>{answer}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="tshirt-cta" aria-labelledby="cta-title">
      <div class="tshirt-shell tshirt-cta-grid">
        <div>
          <p class="tshirt-kicker tshirt-kicker-dark">08 / START A PROJECT</p>
          <h2 id="cta-title">Start Your Custom T-Shirt Project</h2>
          <p>Send your tech pack, reference photos, or sample garment with quantity, size range, fabric direction, decoration, packing, destination, and timing.</p>
        </div>
        <div class="tshirt-cta-actions">
          <a class="tshirt-button tshirt-button-dark" href="/contact-us/">Send your T-shirt brief</a>
          <a class="tshirt-button tshirt-button-outline" href="#tshirt-styles">Review styles</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .tshirt-page {
    --ts-ink: #111511;
    --ts-dark: #151915;
    --ts-muted: #5f675f;
    --ts-line: #dbe0d9;
    --ts-surface: #f5f6f2;
    --ts-accent: #9bd63e;
    --ts-accent-ink: #15200d;
    background: var(--ts-surface);
    color: var(--ts-ink);
  }

  .tshirt-page * { box-sizing: border-box; }
  .tshirt-shell { width: min(1240px, calc(100% - 112px)); margin-inline: auto; }
  .tshirt-hero { background: var(--ts-dark); color: #fff; }
  .tshirt-hero-grid { display: grid; min-height: 680px; grid-template-columns: minmax(0, 1fr) minmax(340px, .72fr); gap: clamp(48px, 8vw, 120px); align-items: center; padding-block: 84px; }
  .tshirt-kicker { margin: 0 0 18px; color: var(--ts-accent); font: 500 11px/1.4 var(--font-mono, monospace); letter-spacing: .1em; text-transform: uppercase; }
  .tshirt-kicker-dark { color: #4d7b21; }
  .tshirt-hero h1 { max-width: 760px; margin: 0; font: 600 clamp(52px, 6.2vw, 82px)/.96 var(--font-display, sans-serif); letter-spacing: -.02em; }
  .tshirt-hero-lead { max-width: 640px; margin: 28px 0 0; color: #cbd2cc; font-size: 18px; line-height: 1.65; }
  .tshirt-actions { display: flex; flex-wrap: wrap; gap: 18px; align-items: center; margin-top: 34px; }
  .tshirt-button, .tshirt-text-link { display: inline-flex; min-height: 48px; align-items: center; justify-content: center; gap: 10px; padding: 12px 18px; font-size: 13px; font-weight: 700; text-decoration: none; transition: background .18s ease, color .18s ease, transform .18s ease; }
  .tshirt-button::after, .tshirt-text-link::after { content: "↗"; font-family: var(--font-mono, monospace); }
  .tshirt-button:hover, .tshirt-text-link:hover { transform: translateY(-2px); }
  .tshirt-button-accent { background: var(--ts-accent); color: var(--ts-accent-ink); }
  .tshirt-button-accent:hover { background: #b2ea55; color: var(--ts-ink); }
  .tshirt-text-link { min-height: 44px; padding-inline: 0; border-bottom: 1px solid currentColor; color: #fff; }
  .tshirt-text-link:hover { color: var(--ts-accent); }
  .tshirt-hero-signals { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-top: 64px; padding-top: 18px; border-top: 1px solid rgba(255,255,255,.2); color: #b8c0b9; font-size: 12px; line-height: 1.4; }
  .tshirt-hero-signals strong { display: block; margin-bottom: 5px; color: var(--ts-accent); font: 500 10px/1.4 var(--font-mono, monospace); }
  .tshirt-placeholder { display: grid; min-height: 290px; align-content: end; gap: 9px; padding: 24px; border: 1px dashed #aab4aa; background: #e8ebe6; color: var(--ts-ink); }
  .tshirt-placeholder span { color: #4d7b21; font: 500 10px/1.4 var(--font-mono, monospace); letter-spacing: .1em; }
  .tshirt-placeholder strong { font: 600 30px/1 var(--font-display, sans-serif); }
  .tshirt-placeholder small { color: var(--ts-muted); font-size: 12px; }
  .tshirt-hero-placeholder { min-height: 520px; border-color: rgba(255,255,255,.45); background: #242b25; color: #fff; }
  .tshirt-hero-placeholder span { color: var(--ts-accent); }
  .tshirt-hero-placeholder small { color: #b8c0b9; }
  .tshirt-photo { margin: 0; }
  .tshirt-photo img { display: block; width: 100%; height: auto; object-fit: cover; aspect-ratio: 3 / 2; background: #dfe3dc; }
  .tshirt-photo figcaption { margin-top: 10px; color: #5f675f; font: 500 10px/1.4 var(--font-mono, monospace); letter-spacing: .08em; text-transform: uppercase; }
  .tshirt-section-ink .tshirt-photo figcaption { color: #b8c0b9; }
  .tshirt-card-media { display: grid; min-height: 170px; align-content: end; gap: 6px; margin: 0 0 20px; padding: 16px; border: 1px dashed #aab4aa; background: #eceee9; }
  .tshirt-card-media span { color: #4d7b21; font: 500 10px/1.4 var(--font-mono, monospace); letter-spacing: .1em; }
  .tshirt-card-media small { color: var(--ts-muted); font-size: 12px; line-height: 1.4; }
  .tshirt-media-note-solo { grid-column: 1 / -1; }
  .tshirt-media-pair { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(220px, 1fr); gap: 18px; }
  .tshirt-workflow { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; margin-top: 44px; }
  .tshirt-quality-media { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; align-content: start; margin-top: 34px; }
  .tshirt-quality-media .tshirt-placeholder { min-height: 0; }
  .tshirt-proof-photo img { aspect-ratio: 2 / 1; }
  .tshirt-proof-photo figcaption { margin-top: 12px; }
  .tshirt-section-ink .tshirt-placeholder { background: #202620; border-color: rgba(255,255,255,.35); color: #fff; }
  .tshirt-section-ink .tshirt-placeholder span { color: var(--ts-accent); }
  .tshirt-section-ink .tshirt-placeholder small { color: #b8c0b9; }
  .tshirt-rail { background: var(--ts-accent); color: var(--ts-accent-ink); }
  .tshirt-rail-grid { display: grid; grid-template-columns: repeat(6, 1fr); }
  .tshirt-rail a { min-height: 58px; display: flex; align-items: center; justify-content: center; padding: 12px 10px; border-right: 1px solid rgba(21,32,13,.18); color: inherit; font: 600 10px/1.3 var(--font-mono, monospace); letter-spacing: .04em; text-align: center; text-decoration: none; text-transform: uppercase; }
  .tshirt-rail a:first-child { border-left: 1px solid rgba(21,32,13,.18); }
  .tshirt-rail a:hover { background: rgba(255,255,255,.2); }
  .tshirt-section { padding-block: clamp(76px, 9vw, 120px); }
  .tshirt-section-light { background: #fff; }
  .tshirt-section-ink { background: var(--ts-dark); color: #fff; }
