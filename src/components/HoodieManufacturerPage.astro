---
import BaseLayout from "../layouts/BaseLayout.astro";
import { hoodiePage as page } from "../../yauum-site-content/page-data/hoodie-manufacturer";

const sectionLinks = [
  ["buyers", "Buyer fit"],
  ["styles", "Styles"],
  ["specification", "Specification"],
  ["fabric", "Fabric & GSM"],
  ["decoration", "Decoration"],
  ["labels", "Private label"],
  ["workflow", "Workflow"],
  ["quality", "Quality"],
  ["inquiry", "Inquiry"],
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://yauum.com/" },
      { "@type": "ListItem", position: 2, name: "Hoodie Manufacturer", item: page.seo.canonical },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Custom and Private Label Hoodie Manufacturing",
    serviceType: "Hoodie manufacturing and product development",
    provider: { "@type": "Organization", name: "Yauum", url: "https://yauum.com/" },
    areaServed: "Worldwide",
    url: page.seo.canonical,
    description: page.seo.description,
  },
];
---

<BaseLayout title={page.seo.title} description={page.seo.description} canonical={page.seo.canonical} jsonLd={jsonLd}>
  <article class="hoodie-page">
    <section class="hoodie-hero">
      <div class="hoodie-shell hoodie-hero-grid">
        <div class="hoodie-hero-copy">
          <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>Hoodie Manufacturer</span></nav>
          <p class="eyebrow">{page.hero.eyebrow}</p>
          <h1>{page.hero.title}</h1>
          <p class="hero-lead">{page.hero.lead}</p>
          <div class="hero-actions">
            <a class="hoodie-button hoodie-button-accent" href="/contact-us/">Send your hoodie brief</a>
            <a class="hoodie-text-link" href="#styles">Explore hoodie options</a>
          </div>
          <ul class="hero-checks" aria-label="Development scope">
            <li>Start with your references</li>
            <li>Check the physical sample</li>
            <li>Confirm details before bulk</li>
          </ul>
        </div>
        <figure class="hoodie-hero-media">
          <img src={page.hero.image} width="1100" height="1100" alt={page.hero.alt} fetchpriority="high" decoding="async" />
          <figcaption><span>Product direction</span> Visual reference image · final specifications require confirmation</figcaption>
        </figure>
      </div>
    </section>

    <nav class="section-index" aria-label="Page sections">
      <div class="hoodie-shell section-index-scroll">
        {sectionLinks.map(([id, label], index) => <a href={`#${id}`}><span>{String(index + 1).padStart(2, "0")}</span>{label}</a>)}
      </div>
    </nav>

    <section class="hoodie-section" id="buyers">
      <div class="hoodie-shell">
        <header class="section-intro split-intro">
          <div><p class="eyebrow">01 / Buyer requirements</p><h2>What do you need from a hoodie manufacturer?</h2></div>
          <p>You need clear answers before you spend money on a sample or bulk order. We’ll help organize the product details, and we won’t guess at MOQ, price, timing, capacity, or certification.</p>
        </header>
        <div class="text-card-grid three-columns">
          {page.buyers.map((item, index) => <article class="text-card"><span>{String(index + 1).padStart(2, "0")}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}
        </div>
      </div>
    </section>

    <section class="hoodie-section section-white" id="styles">
      <div class="hoodie-shell">
        <header class="section-intro split-intro">
          <div><p class="eyebrow">02 / Hoodie styles</p><h2>What kind of hoodie are you planning to make?</h2></div>
          <p>Start with the silhouette. It affects the pattern, fabric, construction, and space available for your artwork. These images are style references, not completed customer orders.</p>
        </header>
        <div class="image-card-grid style-grid">
          {page.styles.map((item, index) => (
            <article class:list={["image-card", index === 0 && "image-card-feature"]}>
              <figure><img src={item.image} width="720" height="720" alt={item.alt} loading="lazy" decoding="async" /><span>Style {String(index + 1).padStart(2, "0")}</span></figure>
              <div><h3>{item.name}</h3><p>{item.text}</p></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="hoodie-section specification-section" id="specification">
      <div class="hoodie-shell spec-layout">
        <header class="section-intro sticky-intro">
          <p class="eyebrow">03 / Custom specification</p>
          <h2>What should you confirm before sampling?</h2>
          <p>A hoodie is more than a front and back image. Confirm the measurements, fabric, construction, color, branding, and packing together. One change can affect several other details.</p>
          <a class="hoodie-text-link dark-link" href="/contact-us/">Prepare a product brief</a>
        </header>
        <div class="spec-list">
          {page.specification.map((item, index) => <article><span>{String(index + 1).padStart(2, "0")}</span><div><h3>{item.title}</h3><p>{item.text}</p></div></article>)}
        </div>
      </div>
    </section>

    <section class="hoodie-section section-dark" id="fabric">
      <div class="hoodie-shell">
        <header class="section-intro split-intro">
          <div><p class="eyebrow accent-eyebrow">04 / Fabric and GSM</p><h2>Which fabric and GSM suit your hoodie?</h2></div>
          <p>GSM tells you the fabric weight per square metre. It does not tell you everything about warmth, softness, shrinkage, or quality. Compare real swatches as well as the composition, knit, surface, and finish.</p>
        </header>
        <div class="fabric-grid">
          {page.fabrics.map((item, index) => (
            <article class="fabric-card">
              <figure><img src={item.image} width="680" height="680" alt={item.alt} loading="lazy" decoding="async" /></figure>
              <span>Material direction {String(index + 1).padStart(2, "0")}</span>
              <h3>{item.name}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
        <aside class="gsm-note">
          <strong>Not sure where to start?</strong>
          <p>Tell us the climate, season, fit, handfeel, artwork, wash expectations, and price range. Those details help narrow the fabric options before you review swatches and samples.</p>
        </aside>
      </div>
    </section>

    <section class="hoodie-section section-white" id="decoration">
      <div class="hoodie-shell">
        <header class="section-intro split-intro">
          <div><p class="eyebrow">05 / Logo application</p><h2>How do you want your logo to look and feel?</h2></div>
          <p>Send vector artwork if you have it. Tell us the size, position, colors, surface effect, and wash expectations. Review a strike-off or decorated sample before bulk production.</p>
        </header>
        <div class="image-card-grid decoration-grid">
          {page.decorations.map((item, index) => (
            <article class="image-card compact-card">
              <figure><img src={item.image} width="680" height="680" alt={item.alt} loading="lazy" decoding="async" /><span>Process {String(index + 1).padStart(2, "0")}</span></figure>
              <div><h3>{item.name}</h3><p>{item.text}</p></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="hoodie-section label-section" id="labels">
      <div class="hoodie-shell">
        <header class="section-intro split-intro">
          <div><p class="eyebrow">06 / Private labels</p><h2>What should carry your brand name?</h2></div>
          <p>Your main label, size label, hangtag, bag sticker, and carton should use the same approved information. Confirm the wording, artwork, barcode, position, and attachment before production.</p>
        </header>
        <div class="label-grid">
          {page.labels.map((item, index) => (
            <article class="label-card">
              <figure><img src={item.image} width="680" height="680" alt={item.alt} loading="lazy" decoding="async" /></figure>
              <div><span>{String(index + 1).padStart(2, "0")}</span><h3>{item.name}</h3><p>{item.text}</p></div>
            </article>
          ))}
        </div>
        <p class="source-note">These label images are visual references. You must supply or approve the final wording, fiber content, origin, care instructions, compliance text, and barcode for your market.</p>
      </div>
    </section>

    <section class="hoodie-section section-accent" id="commercial">
      <div class="hoodie-shell">
        <header class="section-intro split-intro">
          <div><p class="eyebrow">07 / MOQ and quotation</p><h2>What affects your MOQ and unit price?</h2></div>
          <p>There is no useful fixed answer without seeing the hoodie. Fabric, color, construction, artwork, labels, quantity, and packing can all change the MOQ and price.</p>
        </header>
        <div class="text-card-grid three-columns commercial-grid">
          {page.pricing.map((item, index) => <article class="text-card"><span>{String(index + 1).padStart(2, "0")}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}
        </div>
      </div>
    </section>

    <section class="hoodie-section section-white" id="workflow">
      <div class="hoodie-shell workflow-layout">
        <header class="section-intro sticky-intro">
          <p class="eyebrow">08 / Sampling to bulk</p>
          <h2>How does your hoodie move from idea to bulk production?</h2>
          <p>The goal is simple: make the product clear, check a physical sample, record your approval, and use that reference when the order moves into production.</p>
        </header>
        <ol class="timeline">
          {page.workflow.map((item, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><div><h3>{item.title}</h3><p>{item.text}</p></div></li>)}
        </ol>
      </div>
    </section>

    <section class="hoodie-section quality-section" id="quality">
      <div class="hoodie-shell">
        <header class="section-intro split-intro">
          <div><p class="eyebrow">09 / Quality checkpoints</p><h2>What should be checked before your hoodies are packed?</h2></div>
          <p>Agree on the inspection method, tolerances, defect rules, and report before production. The checkpoints below show what to plan; they are not a fixed AQL promise for every order.</p>
        </header>
        <div class="quality-grid">
          {page.quality.map((item, index) => <article><span>{String(index + 1).padStart(2, "0")}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}
        </div>
      </div>
    </section>

    <section class="hoodie-section section-white" id="packing">
      <div class="hoodie-shell packing-layout">
        <div>
          <p class="eyebrow">10 / Packaging and delivery</p>
          <h2>How should your hoodies be packed and delivered?</h2>
          <p class="section-lead-copy">Tell us what happens after the cartons leave production. Retail, e-commerce, warehouse, and wholesale orders may need different labels, bags, carton assortments, and delivery documents.</p>
        </div>
        <div class="packing-list">
          {page.packing.map((item, index) => <article><span>{String(index + 1).padStart(2, "0")}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}
        </div>
      </div>
    </section>

    <section class="hoodie-section section-dark" id="factory">
      <div class="hoodie-shell">
        <header class="section-intro split-intro">
          <div><p class="eyebrow accent-eyebrow">11 / Production environment</p><h2>Where does each production step happen?</h2></div>
          <p>These photos show garment-production equipment and working areas. Use them together with live communication, current company details, project records, and any documents you need to verify before ordering.</p>
        </header>
        <div class="factory-grid">
          {page.factory.map((item, index) => (
            <article class:list={["factory-card", index === 0 && "factory-card-feature"]}>
              <figure><img src={item.image} width="1600" height="1200" alt={item.alt} loading="lazy" decoding="async" /><span>Stage {String(index + 1).padStart(2, "0")}</span></figure>
              <div><h3>{item.title}</h3><p>{item.text}</p></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="hoodie-section faq-section" id="faq">
      <div class="hoodie-shell faq-layout">
        <header class="section-intro sticky-intro">
          <p class="eyebrow">12 / Buyer questions</p>
          <h2>Questions buyers ask before ordering hoodies.</h2>
          <p>Start with the answers below, then confirm project-specific details in the quote, sample record, order documents, and production plan.</p>
        </header>
        <div class="faq-list">
          {page.faq.map((item, index) => (
            <details open={index === 0}>
              <summary><span>{String(index + 1).padStart(2, "0")}</span><h3>{item.question}</h3></summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="hoodie-section inquiry-section" id="inquiry">
      <div class="hoodie-shell inquiry-grid">
        <div>
          <p class="eyebrow accent-eyebrow">13 / Start your inquiry</p>
          <h2>Ready to discuss your hoodie?</h2>
          <p>Send the product, quantity, branding, destination, and open questions together. You do not need every answer before you contact us.</p>
          <a class="hoodie-button hoodie-button-accent" href="/contact-us/">Discuss your hoodie project</a>
        </div>
        <div class="inquiry-checklist">
          <article><span>01</span><h3>Show us the product</h3><p>Send style references, the fit, size range, measurements, colors, and expected quantity.</p></article>
          <article><span>02</span><h3>Explain the fabric and branding</h3><p>Add your fabric or GSM preference, artwork, decoration, labels, trims, and packaging.</p></article>
          <article><span>03</span><h3>Add the order details</h3><p>Tell us the destination, target date, sample needs, trade terms, and any document requirements.</p></article>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .hoodie-page { --hp-line: #d8dbd4; --hp-soft: #eceee8; background: #f5f5f0; color: #1b201c; font-family: var(--font-body); }
  .hoodie-shell { width: min(1280px, calc(100% - (var(--gutter) * 2))); margin-inline: auto; }
  .hoodie-section { padding-block: 50px; scroll-margin-top: 30px; }
  .section-white { background: #fff; }
  .section-dark { background: #171b18; color: #fff; }
  .section-accent { background: var(--accent); color: #17200e; }
  .eyebrow { display: flex; align-items: center; gap: 10px; margin: 0 0 18px; color: #39520c; font-family: var(--font-mono); font-size: 10px; font-weight: 500; letter-spacing: .1em; line-height: 1.4; text-transform: uppercase; }
  .eyebrow::before { width: 24px; height: 2px; background: currentColor; content: ""; }
  .accent-eyebrow { color: var(--accent); }
  h1, h2, h3, p { text-wrap: pretty; }
  h1, h2, h3 { font-family: var(--font-body); }
  .hoodie-page h2 { max-width: 790px; margin: 0; font-size: clamp(34px, 3.8vw, 52px); font-weight: 600; letter-spacing: -.035em; line-height: 1.05; }
  .hoodie-page h3 { margin: 0; font-size: 22px; font-weight: 600; letter-spacing: -.02em; line-height: 1.2; }
  .hoodie-page p { color: #626a63; }
  .section-dark p { color: #bfc6c0; }
  .section-intro { margin-bottom: 25px; }
  .split-intro { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(300px, .75fr); gap: clamp(42px, 8vw, 112px); align-items: end; }
  .split-intro > p { max-width: 54ch; margin: 0; }
  .hoodie-button { display: inline-flex; min-height: 52px; align-items: center; justify-content: center; gap: 12px; padding: 14px 20px; border: 1px solid currentColor; font-size: 14px; font-weight: 700; }
  .hoodie-button::after { content: "↗"; font-family: var(--font-mono); }
  .hoodie-button-accent { border-color: var(--accent); background: var(--accent); color: #17200e; }
  .hoodie-button:hover { transform: translateY(-2px); }
  .hoodie-text-link { display: inline-flex; min-height: 44px; align-items: center; gap: 12px; border-bottom: 1px solid currentColor; color: #fff; font-size: 14px; font-weight: 600; }
  .hoodie-text-link::after { content: "→"; }
  .dark-link { margin-top: 22px; color: #1b201c; }

  .hoodie-hero { background: #171b18; color: #fff; }
  .hoodie-hero-grid { display: grid; min-height: 690px; grid-template-columns: minmax(0, 1.1fr) minmax(390px, .68fr); gap: clamp(40px, 6vw, 88px); align-items: stretch; }
  .hoodie-hero-copy { display: flex; flex-direction: column; justify-content: center; padding-block: 64px; }
  .breadcrumbs { display: flex; gap: 9px; margin-bottom: 48px; color: #89918b; font-size: 12px; }
  .breadcrumbs a:hover { color: var(--accent); }
  .hoodie-hero h1 { max-width: 810px; margin: 0; font-size: clamp(46px, 5vw, 72px); font-weight: 600; letter-spacing: -.045em; line-height: .98; }
  .hero-lead { max-width: 720px; margin: 25px 0 0; color: #c9cfca !important; font-size: 18px; line-height: 1.65; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 22px; margin-top: 28px; }
  .hero-checks { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; margin: 38px 0 0; padding: 0; border-top: 1px solid rgba(255,255,255,.18); list-style: none; }
  .hero-checks li { padding: 16px 18px 0 0; color: #abb3ad; font-size: 12px; line-height: 1.45; }
  .hero-checks li::before { display: block; margin-bottom: 7px; color: var(--accent); content: "✓"; }
  .hoodie-hero-media { position: relative; min-height: 690px; margin: 0; overflow: hidden; background: #e9e9e4; }
  .hoodie-hero-media img { height: 100%; object-fit: cover; object-position: center; }
  .hoodie-hero-media figcaption { position: absolute; right: 0; bottom: 0; left: 0; padding: 13px 15px; background: rgba(20,23,20,.92); color: #cbd1cc; font-size: 10px; letter-spacing: .03em; text-transform: uppercase; }
  .hoodie-hero-media figcaption span { margin-right: 8px; color: var(--accent); font-family: var(--font-mono); }

  .section-index { border-bottom: 1px solid #cdd0c9; background: var(--accent); color: #17200e; }
  .section-index-scroll { display: flex; overflow-x: auto; scrollbar-width: thin; }
  .section-index a { display: inline-flex; min-width: max-content; gap: 9px; padding: 15px 18px; border-right: 1px solid rgba(23,32,14,.18); font-size: 12px; font-weight: 600; }
  .section-index a:first-child { border-left: 1px solid rgba(23,32,14,.18); }
  .section-index a span { font-family: var(--font-mono); font-size: 9px; }
  .section-index a:hover { background: rgba(255,255,255,.28); }

  .text-card-grid { display: grid; border-top: 1px solid var(--hp-line); border-left: 1px solid var(--hp-line); }
  .three-columns { grid-template-columns: repeat(3, 1fr); }
  .text-card { min-height: 245px; padding: 24px; border-right: 1px solid var(--hp-line); border-bottom: 1px solid var(--hp-line); }
  .text-card > span, .label-card span, .quality-grid span, .packing-list span, .inquiry-checklist span { color: #4e6e10; font-family: var(--font-mono); font-size: 10px; }
  .text-card h3 { margin-top: 45px; }
  .text-card p { margin: 14px 0 0; font-size: 14px; }

  .image-card-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: var(--hp-line); border: 1px solid var(--hp-line); }
  .image-card { min-width: 0; background: #fff; }
  .image-card-feature { grid-column: span 2; }
  .image-card figure { position: relative; aspect-ratio: 1 / 1; margin: 0; overflow: hidden; background: #ecece7; }
  .image-card img { height: 100%; object-fit: cover; transition: transform 300ms ease; }
  .image-card:hover img { transform: scale(1.025); }
  .image-card figure span { position: absolute; bottom: 0; left: 0; padding: 8px 10px; background: #171b18; color: var(--accent); font-family: var(--font-mono); font-size: 9px; text-transform: uppercase; }
  .image-card > div { min-height: 205px; padding: 22px; }
  .image-card p { margin: 12px 0 0; font-size: 14px; }
  .image-card-feature { display: grid; grid-template-columns: 1.08fr .92fr; }
  .image-card-feature figure { aspect-ratio: auto; min-height: 450px; }
  .image-card-feature > div { display: flex; min-height: 0; flex-direction: column; justify-content: end; }

  .specification-section { background: #eef0ea; }
  .spec-layout, .workflow-layout, .faq-layout { display: grid; grid-template-columns: minmax(280px, .72fr) minmax(0, 1.28fr); gap: clamp(48px, 9vw, 130px); align-items: start; }
  .sticky-intro { position: sticky; top: 28px; }
  .sticky-intro > p:not(.eyebrow) { margin: 20px 0 0; }
  .spec-list { border-top: 1px solid #bdc2b9; }
  .spec-list article { display: grid; grid-template-columns: 48px 1fr; gap: 20px; padding: 25px 0; border-bottom: 1px solid #bdc2b9; }
  .spec-list span, .timeline > li > span { color: #4e6e10; font-family: var(--font-mono); font-size: 10px; }
  .spec-list p { margin: 10px 0 0; }

  .fabric-grid { display: grid; grid-template-columns: repeat(5, 1fr); border-top: 1px solid rgba(255,255,255,.16); border-left: 1px solid rgba(255,255,255,.16); }
  .fabric-card { min-width: 0; padding: 14px; border-right: 1px solid rgba(255,255,255,.16); border-bottom: 1px solid rgba(255,255,255,.16); }
  .fabric-card figure { aspect-ratio: 1; margin: 0 0 18px; overflow: hidden; background: #242a25; }
  .fabric-card img { height: 100%; object-fit: cover; }
  .fabric-card > span { color: var(--accent); font-family: var(--font-mono); font-size: 8px; text-transform: uppercase; }
  .fabric-card h3 { margin-top: 11px; font-size: 20px; }
  .fabric-card p { margin: 10px 0 4px; font-size: 13px; }
  .gsm-note { display: grid; grid-template-columns: minmax(220px, .4fr) minmax(0, 1.6fr); gap: 30px; margin-top: 25px; padding: 24px; border: 1px solid rgba(255,255,255,.2); }
  .gsm-note strong { color: var(--accent); font-size: 16px; }
  .gsm-note p { margin: 0; }

  .decoration-grid { grid-template-columns: repeat(3, 1fr); }
  .compact-card > div { min-height: 190px; }
  .label-section { background: #f0f1ec; }
  .label-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1px; background: #cfd3ca; border: 1px solid #cfd3ca; }
  .label-card { min-width: 0; background: #f8f8f4; }
  .label-card figure { aspect-ratio: 1; margin: 0; overflow: hidden; }
  .label-card img { height: 100%; object-fit: cover; }
  .label-card > div { padding: 18px; }
  .label-card h3 { margin-top: 9px; font-size: 19px; }
  .label-card p { margin: 10px 0 0; font-size: 13px; }
  .source-note { max-width: 1000px; margin: 20px 0 0; padding-left: 16px; border-left: 3px solid var(--accent); font-size: 13px; }
  .commercial-grid { border-color: rgba(23,32,14,.25); }
  .commercial-grid .text-card { border-color: rgba(23,32,14,.25); }
  .commercial-grid p { color: #314018; }

  .timeline { margin: 0; padding: 0; border-top: 1px solid var(--hp-line); list-style: none; }
  .timeline li { display: grid; grid-template-columns: 55px 1fr; gap: 20px; padding: 25px 0; border-bottom: 1px solid var(--hp-line); }
  .timeline p { margin: 10px 0 0; }
  .quality-section { background: #e9ece5; }
  .quality-grid { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid #bfc5ba; border-left: 1px solid #bfc5ba; }
  .quality-grid article { min-height: 280px; padding: 24px; border-right: 1px solid #bfc5ba; border-bottom: 1px solid #bfc5ba; }
