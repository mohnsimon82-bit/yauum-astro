  <Fragment slot="scripts">
    <script is:inline>(function () {
      // reveal-on-scroll: one-shot fade + 10px lift per container, 60ms
      // stagger across direct children. Honors prefers-reduced-motion.
      var targets = document.querySelectorAll(
        '.section-head, .buyer-cards, .cat-grid, .steps-vertical, ' +
        '.modules, .evidence, .pack-grid, .form-grid'
      );
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduce || !('IntersectionObserver' in window)) {
        targets.forEach(function (el) { el.classList.add('in'); });
        return;
      }

      targets.forEach(function (container) {
        if (container.classList.contains('section-head')) return;
        Array.prototype.forEach.call(container.children, function (child, i) {
          child.style.setProperty('--i', i);
        });
      });

      var obs = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('in');
            obs.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -8% 0px' });

      targets.forEach(function (el) { obs.observe(el); });
    })();</script>
  </Fragment>
