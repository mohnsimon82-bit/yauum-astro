---
/** 
 * index（V2 家族版式，2026-10-11 起）。
 *
 * 由终审定稿的预览成品移植：hero-v1-真实内容.html
 * （07-开发分析与临时产物/首页v2-配图预览-2026-10-10/）。
 * 版式与文案逐字保留；页头/页脚改用共享 chrome 组件（V2Layout，其样式在页面
 * CSS 的「全局页头/页脚样式（绿色→紫罗兰映射）」段）；询盘表单保留原标记，
 * 接线换成真实投递链路（action=/api/inquiry + InquirySubmitScript）；SEO 文案
 * 取自 src/lib/seo.ts 的同路径条目，与旧版逐字一致（面包屑 / 内链 / 原文经
 * 全站终审核对）。页面级样式：src/styles/pages/index.css。
 */
import V2Layout from "../layouts/V2Layout.astro";
import { getSeo } from "../lib/seo";
import "../styles/pages/index.css";
---

<V2Layout seo={getSeo("/")} navCurrent={["/"]}>
<!-- ─── 01 / Hero ─────────────────────────────────────────────────── -->
<section class="hero" data-od-id="hero">
<div class="container">
<div class="hero-inner">
<div class="hero-text">
<span class="eyebrow">B2B / Private label / OEM-ODM</span>
<h1>Custom Clothing Manufacturing, <span class="hl">Made Clear</span> Before Bulk</h1>
<p class="lead">Yauum helps overseas apparel brands, wholesalers, sourcing teams, and procurement buyers develop menswear and streetwear through a sample-first workflow: from product brief and material review to private label finishing, inspection, and shipment preparation</p>
<div class="hero-cta">
<a class="btn btn-primary" href="#inquiry">Send your product brief</a>
<a class="btn btn-ghost btn-arrow" href="#production-process">Review the production path</a>
</div>
</div>
<div class="hero-media" data-od-id="hero-image">
<img alt="Garment sewing line with operators and workstations" class="media-img" decoding="async" fetchpriority="high" src="/uploads/factory/factory-sewing-line-wide.webp"/>
</div>
</div>
<div class="hero-meta" data-od-id="hero-summary">
<div class="item"><span class="k">01 Product scope</span></div>
<div class="item"><span class="k">02 Sample before bulk</span></div>
<div class="item"><span class="k">03 Inspection and pack-out</span></div>
</div>
</div>
</section>
