---
const productLinks = [
  ["01", "Hoodies", "/hoodie-manufacturer/"],
  ["02", "T-Shirts", "/t-shirt-manufacturer/"],
  ["03", "Jackets", "/jackets-manufacturer/"],
  ["04", "Pants", "/pants-manufacturer/"],
  ["05", "Sportswear", "/sportswear-manufacturer/"],
  ["06", "Streetwear", "/streetwear-manufacturer/"],
];

const pathname = Astro.url.pathname;
const isActive = (href: string) => href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="Yauum home">
      <img src="/uploads/logo/yauum-site-logo.svg" alt="YAUUM" width="800" height="600" />
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <a class:list={[{ active: isActive("/our-services/") }]} href="/our-services/">Services</a>
      <div class="nav-products">
        <button class="nav-products-trigger" type="button" aria-haspopup="true">Products</button>
        <div class="product-panel">
          {productLinks.map(([number, label, href]) => (
            <a href={href}>
              <span>{number} / PRODUCT</span>
              <strong>{label}</strong>
            </a>
          ))}
        </div>
      </div>
      <a class:list={[{ active: isActive("/production/") }]} href="/production/">Production</a>
      <a class:list={[{ active: isActive("/solutions/") }]} href="/solutions/">Solutions</a>
      <a class:list={[{ active: isActive("/about-us/") }]} href="/about-us/">About</a>
      <a class:list={[{ active: isActive("/blog/") }]} href="/blog/">Insights</a>
    </nav>

    <a class="button header-cta" href="/contact-us/">Send an inquiry</a>
    <button class="menu-button" type="button" aria-label="Open menu" aria-controls="mobile-menu" aria-expanded="false" data-menu-open>
      <span class="menu-button-lines" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Site menu">
  <div class="mobile-menu-inner">
    <div class="mobile-menu-head">
      <a class="brand brand-on-dark" href="/" aria-label="Yauum home">
        <img src="/uploads/logo/yauum-site-logo.svg" alt="YAUUM" width="800" height="600" />
      </a>
      <button class="menu-close" type="button" aria-label="Close menu" data-menu-close>×</button>
    </div>
    <nav class="mobile-menu-nav" aria-label="Mobile primary navigation">
      <a href="/our-services/">Services</a>
      <a href="/production/">Production</a>
      <a href="/solutions/">Solutions</a>
      <a href="/about-us/">About</a>
      <a href="/blog/">Insights</a>
    </nav>
    <p class="mobile-product-label">Product categories</p>
    <div class="mobile-product-grid">
      {productLinks.map(([, label, href]) => <a href={href}>{label}</a>)}
    </div>
    <a class="button button-accent mobile-menu-cta" href="/contact-us/">Send your project details</a>
  </div>
</div>

<a class="mobile-inquiry" href="/contact-us/">Send an inquiry <span aria-hidden="true">↗</span></a>

<a
  class="whatsapp-float"
  href="https://wa.me/8615733728976"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat with YAUUM on WhatsApp"
  title="Chat with YAUUM on WhatsApp"
>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M12.04 2a9.84 9.84 0 0 0-8.42 14.93L2 22l5.2-1.62A9.88 9.88 0 1 0 12.04 2Zm0 1.67a8.2 8.2 0 1 1-4.56 15.02l-.32-.19-3.01.94.96-2.93-.21-.34A8.17 8.17 0 0 1 12.04 3.67Zm-3.1 3.86c-.18 0-.47.07-.72.34-.25.27-.95.93-.95 2.27 0 1.34.98 2.64 1.11 2.82.14.18 1.92 2.93 4.66 4.11.65.28 1.16.45 1.56.58.66.21 1.25.18 1.72.11.52-.08 1.61-.66 1.84-1.3.23-.64.23-1.19.16-1.3-.06-.11-.25-.18-.52-.32-.27-.14-1.61-.8-1.86-.89-.25-.09-.43-.14-.61.14-.18.27-.7.89-.86 1.07-.16.18-.32.2-.59.07-.27-.14-1.15-.42-2.19-1.35a8.2 8.2 0 0 1-1.51-1.88c-.16-.27-.02-.42.12-.55.12-.12.27-.32.41-.48.13-.16.18-.27.27-.45.09-.18.04-.34-.02-.48-.07-.14-.61-1.48-.84-2.02-.22-.53-.45-.46-.61-.47h-.53Z" />
  </svg>
</a>

<script>
  const openButton = document.querySelector<HTMLButtonElement>("[data-menu-open]");
  const closeButton = document.querySelector<HTMLButtonElement>("[data-menu-close]");
  const menu = document.getElementById("mobile-menu");

  if (openButton && closeButton && menu) {
    const setMenu = (isOpen: boolean) => {
      menu.setAttribute("aria-hidden", String(!isOpen));
      openButton.setAttribute("aria-expanded", String(isOpen));
      document.body.classList.toggle("menu-open", isOpen);
      isOpen ? closeButton.focus() : openButton.focus();
    };

    openButton.addEventListener("click", () => setMenu(true));
    closeButton.addEventListener("click", () => setMenu(false));
    menu.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      if (target === menu || target.closest("a")) setMenu(false);
    });
    document.addEventListener("keydown", (event) => {
      if (menu.getAttribute("aria-hidden") === "true") return;
      if (event.key === "Escape") setMenu(false);
    });
  }
</script>
