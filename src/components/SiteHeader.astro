---
const productLinks = [
  ["01", "Hoodies", "/hoodie-manufacturer/"],
  ["02", "T-Shirts", "/t-shirt-manufacturer/"],
  ["03", "Jackets", "/jackets-manufacturer/"],
  ["04", "Pants", "/pants-manufacturer/"],
  ["05", "Sportswear", "/sportswear-manufacturer/"],
  ["06", "Streetwear", "/streetwear-manufacturer/"],
];

const pathname = Astro.url.pathname;
const isActive = (href: string) => href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="Yauum home">
      <img src="/uploads/logo/yauum-site-logo.webp" alt="Yauum" width="594" height="594" />
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <a class:list={[{ active: isActive("/") }]} aria-current={isActive("/") ? "page" : undefined} href="/">Home</a>
      <a class:list={[{ active: isActive("/our-services/") }]} aria-current={isActive("/our-services/") ? "page" : undefined} href="/our-services/">Our Services</a>
      <a class:list={[{ active: isActive("/solutions/") }]} aria-current={isActive("/solutions/") ? "page" : undefined} href="/solutions/">Solutions</a>
      <div class="nav-production">
        <a class:list={["nav-production-link", { active: isActive("/production/") || productLinks.some(([, , href]) => isActive(href)) }]} aria-current={isActive("/production/") ? "page" : undefined} href="/production/">Production</a>
        <button class="nav-production-trigger" type="button" aria-label="Show production categories" aria-haspopup="true" aria-expanded="false" aria-controls="production-panel">+</button>
        <div class="production-panel" id="production-panel" aria-label="Production product categories">
          <a class="production-overview" href="/production/"><span>00 / OVERVIEW</span><strong>Production</strong></a>
          {productLinks.map(([number, label, href]) => (
            <a class:list={[{ active: isActive(href) }]} href={href}>
              <span>{number} / PRODUCT</span>
              <strong>{label}</strong>
            </a>
          ))}
        </div>
      </div>
      <a class:list={[{ active: isActive("/about-us/") }]} aria-current={isActive("/about-us/") ? "page" : undefined} href="/about-us/">About</a>
      <a class:list={[{ active: isActive("/blog/") }]} aria-current={isActive("/blog/") ? "page" : undefined} href="/blog/">Blog</a>
    </nav>

    <a class="button header-cta" href="/contact-us/">Send an inquiry</a>
    <button class="menu-button" type="button" aria-label="Open menu" aria-controls="mobile-menu" aria-expanded="false" data-menu-open>
      <span class="menu-button-lines" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Site menu">
  <div class="mobile-menu-inner">
    <div class="mobile-menu-head">
      <a class="brand brand-on-dark" href="/" aria-label="Yauum home">
        <img src="/uploads/logo/yauum-site-logo.webp" alt="Yauum" width="594" height="594" />
      </a>
      <button class="menu-close" type="button" aria-label="Close menu" data-menu-close>×</button>
    </div>
    <nav class="mobile-menu-nav" aria-label="Mobile primary navigation">
      <a class:list={[{ active: isActive("/") }]} aria-current={isActive("/") ? "page" : undefined} href="/">Home</a>
      <a class:list={[{ active: isActive("/our-services/") }]} aria-current={isActive("/our-services/") ? "page" : undefined} href="/our-services/">Our Services</a>
      <a class:list={[{ active: isActive("/solutions/") }]} aria-current={isActive("/solutions/") ? "page" : undefined} href="/solutions/">Solutions</a>
      <details class="mobile-production-group" open={isActive("/production/") || productLinks.some(([, , href]) => isActive(href))}>
        <summary class:list={["mobile-production-trigger", { active: isActive("/production/") || productLinks.some(([, , href]) => isActive(href)) }]}>Production</summary>
        <div class="mobile-production-products" aria-label="Production product categories">
          <a class="mobile-production-overview" href="/production/">Production overview</a>
          {productLinks.map(([number, label, href]) => <a class:list={[{ active: isActive(href) }]} href={href}><span>{number}</span>{label}</a>)}
        </div>
      </details>
      <a class:list={[{ active: isActive("/about-us/") }]} aria-current={isActive("/about-us/") ? "page" : undefined} href="/about-us/">About</a>
      <a class:list={[{ active: isActive("/blog/") }]} aria-current={isActive("/blog/") ? "page" : undefined} href="/blog/">Blog</a>
    </nav>
    <a class="button button-accent mobile-menu-cta" href="/contact-us/">Send your project details</a>
  </div>
</div>

<a class="mobile-inquiry" href="/contact-us/">Send an inquiry <span aria-hidden="true">↗</span></a>

<div class="contact-dock" aria-label="Direct contact options">
  <a class="contact-dock-link contact-dock-whatsapp" href="https://wa.me/8615733728976?text=Hello%20Yauum%2C%20I%27d%20like%20to%20discuss%20a%20clothing%20manufacturing%20project." target="_blank" rel="noopener noreferrer" aria-label="Chat with Yauum on WhatsApp" title="WhatsApp">
    <svg class="contact-dock-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20.5 11.4a8.4 8.4 0 0 1-12.4 7.4L3.5 20l1.3-4.3A8.4 8.4 0 1 1 20.5 11.4Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M8.8 8.2c.2-.3.4-.3.7-.3h.5c.2 0 .4.1.5.4l.6 1.5c.1.2.1.4-.1.6l-.5.6c.5 1 1.2 1.7 2.2 2.2l.6-.5c.2-.2.4-.2.6-.1l1.5.6c.3.1.4.3.4.5v.5c0 .3-.1.5-.3.7-.3.3-.8.5-1.2.4-2.5-.4-5.5-3.4-5.9-5.9-.1-.4.1-.9.4-1.2Z" fill="currentColor"/></svg>
  </a>
  <a class="contact-dock-link contact-dock-email" href="mailto:mumu@yauum.com?subject=Yauum%20manufacturing%20inquiry" aria-label="Email Yauum" title="Email">
    <svg class="contact-dock-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m4 7 8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </a>
</div>

<button class="back-to-top" type="button" aria-label="Back to top" title="Back to top" data-back-to-top>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 19V5M6.5 10.5 12 5l5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
</button>

<script>
  const openButton = document.querySelector<HTMLButtonElement>("[data-menu-open]");
  const closeButton = document.querySelector<HTMLButtonElement>("[data-menu-close]");
  const menu = document.getElementById("mobile-menu");

  if (openButton && closeButton && menu) {
    const focusableSelector = 'a[href], button:not([disabled]), summary';
    const setMenu = (isOpen: boolean) => {
      menu.setAttribute("aria-hidden", String(!isOpen));
      openButton.setAttribute("aria-expanded", String(isOpen));
      document.body.classList.toggle("menu-open", isOpen);
      isOpen ? closeButton.focus() : openButton.focus();
    };

    openButton.addEventListener("click", () => setMenu(true));
    closeButton.addEventListener("click", () => setMenu(false));
    menu.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      if (target === menu || target.closest("a")) setMenu(false);
    });
    document.addEventListener("keydown", (event) => {
      if (menu.getAttribute("aria-hidden") === "true") return;
      if (event.key === "Escape") setMenu(false);
      if (event.key !== "Tab") return;
      const focusable = [...menu.querySelectorAll<HTMLElement>(focusableSelector)];
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (!first || !last) return;
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
      if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
    });
  }

  const productionToggle = document.querySelector<HTMLButtonElement>(".nav-production-trigger");
  const productionMenu = document.getElementById("production-panel");
  if (productionToggle && productionMenu) {
    const setProductionMenu = (open: boolean) => {
      productionToggle.setAttribute("aria-expanded", String(open));
      productionMenu.toggleAttribute("data-open", open);
    };

    productionToggle.addEventListener("click", () => {
      setProductionMenu(productionToggle.getAttribute("aria-expanded") !== "true");
    });
    document.addEventListener("click", (event) => {
      const target = event.target as Node;
      if (!productionMenu.contains(target) && target !== productionToggle) setProductionMenu(false);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setProductionMenu(false);
    });
  }

  const backToTop = document.querySelector<HTMLButtonElement>("[data-back-to-top]");
  if (backToTop) {
    const updateBackToTop = () => backToTop.toggleAttribute("data-visible", window.scrollY > 520);
    window.addEventListener("scroll", updateBackToTop, { passive: true });
    updateBackToTop();
    backToTop.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));
  }
</script>
