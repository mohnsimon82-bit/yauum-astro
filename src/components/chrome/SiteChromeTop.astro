---
// 站点公共页头：skip-link / header / 移动菜单 / 移动吸底询盘条 / 浮动联系栏 / 回顶按钮
// 由 OpenDesign 导出逐字提取，以最晚导出的设计稿（streetwear 2026-09-25）为准，
// Production 下拉带 + 切换按钮。新设计页面直接使用；旧设计页面额外挂 ed 作用域类，
// 配合 src/styles/site-chrome.css 压过 global.css 中的旧页头样式。
interface Props {
  mainId?: string;
  navCurrent?: string[];
  showMobileInquiry?: boolean;
}

const {
  mainId = "main-content",
  navCurrent = [],
  showMobileInquiry = false,
} = Astro.props;
const isCurrent = (href: string) => navCurrent.includes(href);
// 全站统一页头：所有页面都挂 ed 作用域类，样式只来自 site-chrome.css
const c = (base: string) => `${base} ed`;
---

    <a class={c("skip-link")} href={"#" + mainId}>Skip to content</a>

    <header class={c("site-header")} data-od-id="site-header">
          <div class="shell header-inner">
            <a class="brand" href="/" aria-label="Yauum home">
              <img src="/uploads/logo/yauum-site-logo.webp" alt="Yauum" width="852" height="215" decoding="async" />
            </a>

            <nav class="nav" aria-label="Primary navigation">
              <a  aria-current={isCurrent("/") ? "page" : undefined} href="/">Home</a>
              <a aria-current={isCurrent("/our-services/") ? "page" : undefined} href="/our-services/">Our Services</a>
              <a aria-current={isCurrent("/solutions/") ? "page" : undefined} href="/solutions/">Solutions</a>
              <div class="nav-prod">
                <a class="nav-prod-btn" aria-current={isCurrent("/production/") ? "page" : undefined} href="/production/">Production</a>
                <button class="nav-prod-toggle" type="button" aria-label="Show production categories" aria-haspopup="true" aria-expanded="false" aria-controls="production-panel">+</button>
                <div class="prod-panel" id="production-panel" aria-label="Production product categories">
                  <a class="prod-overview" href="/production/"><span>00 / OVERVIEW</span><strong>Production</strong></a>
                  <a aria-current={isCurrent("/hoodie-manufacturer/") ? "page" : undefined} href="/hoodie-manufacturer/"><span>01 / PRODUCT</span><strong>Hoodies</strong></a>
                  <a aria-current={isCurrent("/t-shirt-manufacturer/") ? "page" : undefined} href="/t-shirt-manufacturer/"><span>02 / PRODUCT</span><strong>T-Shirts</strong></a>
                  <a aria-current={isCurrent("/jackets-manufacturer/") ? "page" : undefined} href="/jackets-manufacturer/"><span>03 / PRODUCT</span><strong>Jackets</strong></a>
                  <a aria-current={isCurrent("/pants-manufacturer/") ? "page" : undefined} href="/pants-manufacturer/"><span>04 / PRODUCT</span><strong>Pants</strong></a>
                  <a aria-current={isCurrent("/sportswear-manufacturer/") ? "page" : undefined} href="/sportswear-manufacturer/"><span>05 / PRODUCT</span><strong>Sportswear</strong></a>
                  <a aria-current={isCurrent("/streetwear-manufacturer/") ? "page" : undefined} href="/streetwear-manufacturer/"><span>06 / PRODUCT</span><strong>Streetwear</strong></a>
                </div>
              </div>
              <a aria-current={isCurrent("/about-us/") ? "page" : undefined} href="/about-us/">About</a>
              <a aria-current={isCurrent("/blog/") ? "page" : undefined} href="/blog/">Blog</a>
            </nav>

            <a class="button header-cta" href="/contact-us/">Send an inquiry</a>
            <button class="menu-btn" type="button" aria-label="Open menu" aria-controls="mobile-menu" aria-expanded="false" data-menu-open>
              <span class="menu-lines" aria-hidden="true"><i></i><i></i></span>
            </button>
          </div>
        </header>

    <div class={c("mobile-menu")} id="mobile-menu" data-menu aria-hidden="true" role="dialog" aria-modal="true" aria-label="Site menu">
          <div class="mm-inner">
            <div class="mm-head">
              <a class="brand brand-chip" href="/" aria-label="Yauum home">
                <img src="/uploads/logo/yauum-site-logo.webp" alt="Yauum" width="852" height="215" loading="lazy" decoding="async" />
              </a>
              <button class="mm-close" type="button" aria-label="Close menu" data-menu-close>&times;</button>
            </div>
            <nav class="mm-nav" aria-label="Mobile primary navigation">
              <a aria-current={isCurrent("/") ? "page" : undefined} href="/">Home</a>
              <a aria-current={isCurrent("/our-services/") ? "page" : undefined} href="/our-services/">Our Services</a>
              <a aria-current={isCurrent("/solutions/") ? "page" : undefined} href="/solutions/">Solutions</a>
              <details class="mm-prod" open={isCurrent("/production/")}>
                <summary class="mm-prod-summary" aria-current={isCurrent("/production/") ? "page" : undefined}>Production</summary>
                <div class="mm-prod-list" aria-label="Production product categories">
                  <a href="/production/">Production overview</a>
                  <a  aria-current={isCurrent("/hoodie-manufacturer/") ? "page" : undefined} href="/hoodie-manufacturer/"><span>01</span>Hoodies</a>
                  <a aria-current={isCurrent("/t-shirt-manufacturer/") ? "page" : undefined} href="/t-shirt-manufacturer/"><span>02</span>T-Shirts</a>
                  <a aria-current={isCurrent("/jackets-manufacturer/") ? "page" : undefined} href="/jackets-manufacturer/"><span>03</span>Jackets</a>
                  <a aria-current={isCurrent("/pants-manufacturer/") ? "page" : undefined} href="/pants-manufacturer/"><span>04</span>Pants</a>
                  <a aria-current={isCurrent("/sportswear-manufacturer/") ? "page" : undefined} href="/sportswear-manufacturer/"><span>05</span>Sportswear</a>
                  <a aria-current={isCurrent("/streetwear-manufacturer/") ? "page" : undefined} href="/streetwear-manufacturer/"><span>06</span>Streetwear</a>
                </div>
              </details>
              <a aria-current={isCurrent("/about-us/") ? "page" : undefined} href="/about-us/">About</a>
              <a aria-current={isCurrent("/blog/") ? "page" : undefined} href="/blog/">Blog</a>
            </nav>
            <div class="mm-cta">
              <a class="button" href="/contact-us/">Send your project details</a>
            </div>
          </div>
        </div>

    {showMobileInquiry && (
          <a class={c("mobile-inquiry")} href="/contact-us/">Send an inquiry <span aria-hidden="true">↗</span></a>
        )}

    <div class={c("contact-dock")} aria-label="Direct contact options">
          <a class="dock-btn" href="https://wa.me/8617615152039?text=Hello%20Yauum%2C%20I%27d%20like%20to%20discuss%20a%20clothing%20manufacturing%20project." target="_blank" rel="noopener noreferrer" aria-label="Chat with Yauum on WhatsApp" title="WhatsApp">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20.5 11.4a8.4 8.4 0 0 1-12.4 7.4L3.5 20l1.3-4.3A8.4 8.4 0 1 1 20.5 11.4Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M8.8 8.2c.2-.3.4-.3.7-.3h.5c.2 0 .4.1.5.4l.6 1.5c.1.2.1.4-.1.6l-.5.6c.5 1 1.2 1.7 2.2 2.2l.6-.5c.2-.2.4-.2.6-.1l1.5.6c.3.1.4.3.4.5v.5c0 .3-.1.5-.3.7-.3.3-.8.5-1.2.4-2.5-.4-5.5-3.4-5.9-5.9-.1-.4.1-.9.4-1.2Z" fill="currentColor"/></svg>
          </a>
          <a class="dock-btn" href="mailto:virgil.yauvy@gmail.com?subject=Yauum%20manufacturing%20inquiry" aria-label="Email Yauum" title="Email">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="m4 7 8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>

    <button class={c("back-top")} type="button" aria-label="Back to top" title="Back to top" data-back-to-top>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 19V5M6.5 10.5 12 5l5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
