---
// 站点公共页脚：全站唯一实现，两个 layout 都只调用本组件。
// 样式全部来自 site-chrome.css 的全局 .site-footer 选择器（不依赖 .ed 作用域），
// 因此无论页面是否带 ed 类，页脚渲染都一致。
import { localeFromPathname } from "../../lib/i18n";
import { chromeLabels } from "../../lib/chrome-labels";

interface Props {
  navCurrent?: string[];
}

const { navCurrent = [] } = Astro.props;
const isCurrent = (href: string) => navCurrent.includes(href);
const labels = chromeLabels(localeFromPathname(Astro.url.pathname));
---

    <footer class="site-footer" data-od-id="site-footer" data-no-translate>
          <div class="shell footer-grid">
            <div class="footer-brand-col">
              <a class="brand brand-chip" href="/" aria-label={labels.brandHome}>
                <img src="/uploads/logo/yauum-site-logo.webp" alt="Yauum" width="594" height="594" loading="lazy" decoding="async" />
              </a>
              <p>{labels.footerIntro}</p>
              <div class="footer-contact" aria-label={labels.directContactDetails}>
                <a href="https://wa.me/8615733728976?text=Hello%20Yauum%2C%20I%27d%20like%20to%20discuss%20a%20clothing%20manufacturing%20project." target="_blank" rel="noopener noreferrer">WhatsApp / +86 157 3372 8976</a>
                <a href="mailto:mumu@yauum.com?subject=Yauum%20manufacturing%20inquiry">Email / mumu@yauum.com</a>
              </div>
            </div>
            <nav class="footer-col" aria-label={labels.companyLinks}>
              <p class="footer-label">{labels.company}</p>
              <a href="/">{labels.home}</a>
              <a aria-current={isCurrent("/our-services/") ? "page" : undefined} href="/our-services/">{labels.ourServices}</a>
              <a aria-current={isCurrent("/solutions/") ? "page" : undefined} href="/solutions/">{labels.solutions}</a>
              <a href="/production/">{labels.production}</a>
              <a aria-current={isCurrent("/about-us/") ? "page" : undefined} href="/about-us/">{labels.about}</a>
              <a aria-current={isCurrent("/blog/") ? "page" : undefined} href="/blog/">{labels.blog}</a>
            </nav>
            <nav class="footer-col" aria-label={labels.productLinks1}>
              <p class="footer-label">{labels.products1}</p>
              <a aria-current={isCurrent("/hoodie-manufacturer/") ? "page" : undefined} href="/hoodie-manufacturer/">{labels.hoodies}</a>
              <a aria-current={isCurrent("/t-shirt-manufacturer/") ? "page" : undefined} href="/t-shirt-manufacturer/">{labels.tshirts}</a>
              <a aria-current={isCurrent("/jackets-manufacturer/") ? "page" : undefined} href="/jackets-manufacturer/">{labels.jackets}</a>
            </nav>
            <nav class="footer-col" aria-label={labels.productLinks2}>
              <p class="footer-label">{labels.products2}</p>
              <a aria-current={isCurrent("/pants-manufacturer/") ? "page" : undefined} href="/pants-manufacturer/">{labels.pants}</a>
              <a aria-current={isCurrent("/sportswear-manufacturer/") ? "page" : undefined} href="/sportswear-manufacturer/">{labels.sportswear}</a>
              <a aria-current={isCurrent("/streetwear-manufacturer/") ? "page" : undefined} href="/streetwear-manufacturer/">{labels.streetwear}</a>
              <a href="/contact-us/">{labels.contactYauum}</a>
            </nav>
          </div>
          <div class="shell footer-bottom">
            <span>{labels.copyright}</span>
            <a class="footer-llm-link" href="/llm-instructions/">{labels.aiReference}</a>
          </div>
        </footer>

<style>
  .footer-llm-link {
    color: #9aa39a;
    border-bottom: 1px solid transparent;
    transition: color .16s ease, border-color .16s ease;
  }
  .footer-llm-link:hover {
    color: #C9B0E8;
    border-bottom-color: #C9B0E8;
  }
</style>
