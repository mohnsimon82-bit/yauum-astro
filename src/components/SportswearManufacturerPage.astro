---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { WebsitePage } from "../lib/content";

interface Props {
  page: WebsitePage;
}

type MediaSlot = {
  title: string;
  detail: string;
  label: string;
};

type Section = {
  id: string;
  number: string;
  rail: string;
  title: string;
  lead: string;
  tone: "light" | "ink";
  items: Array<{ title: string; body: string }>;
  paragraphs?: string[];
  media?: MediaSlot;
};

const { page } = Astro.props;

const sections: Section[] = [
  {
    id: "sportswear-products",
    number: "01",
    rail: "Products",
    title: "What Sportswear Products Do You Want to Customize?",
    lead: "Start with the garment you want to sell. Training tops, running shorts, joggers, track jackets, and team jerseys create different fit, fabric, artwork, and quantity decisions. Choose the product family before specifying details.",
    tone: "light",
    items: [
      {
        title: "Training Tops and Base Layers",
        body: "Possible directions include training T-shirts, tanks, compression tops, and base layers. State the activity, layering need, sleeve, neckline, body length, fit, and coverage so the sample has a clear purpose.",
      },
      {
        title: "Sports Shorts, Joggers, and Track Pants",
        body: "For bottoms, specify the activity first. A running short may prioritize low bulk and secure storage; a jogger may need a defined leg shape. Include rise, inseam, waistband, liner, pockets, leg opening, and mobility.",
      },
      {
        title: "Track Jackets and Coordinated Sets",
        body: "Plan a track jacket or tracksuit as one coordinated product. Align jacket length, pant shape, panels, colors, trims, branding, and sizes. If sold separately, make sure each garment also works alone.",
      },
      {
        title: "Team Jerseys and Sport-Specific Directions",
        body: "Teamwear may need names, numbers, sponsor artwork, club colors, and consistent placement. Identify the sport, uniform pieces, roster variations, and reorder expectations for decoration and order review.",
      },
    ],
    media: {
      title: "Sportswear product range",
      detail: "Needed: verified front-and-back product views grouped by tops, bottoms, outer layers, and teamwear.",
      label: "Pending image slot for verified sportswear product types",
    },
  },
  {
    id: "sportswear-styles",
    number: "02",
    rail: "Styles",
    title: "Explore Sportswear Styles for Your Collection",
    lead: "Next, define the collection direction. A T-shirt or short changes when designed for gym training, running, team use, or active lifestyle retail. This choice guides silhouette, material, construction, color, and branding.",
    tone: "ink",
    items: [
      {
        title: "Gym and Training Styles",
        body: "For gym or general training, choose a supportive, lightweight, relaxed, or layered direction. Identify the main movements, wearer, coverage, storage needs, and whether tops and bottoms share one visual system.",
      },
      {
        title: "Running and Outdoor Training Styles",
        body: "Running styles may prioritize low bulk, ventilation, secure pockets, movement, and visibility details. Define the training context, climate, layering plan, and selling season before selecting shape and features.",
      },
      {
        title: "Teamwear, Club, and Active Lifestyle Styles",
        body: "Teamwear may need coordinated colors, names, numbers, and repeatable artwork. Active lifestyle ranges may prioritize easy silhouettes and matching sets. State whether the range is for competition, club use, warm-up, travel, or retail.",
      },
    ],
    media: {
      title: "Collection style directions",
      detail: "Needed: verified gym, running, teamwear, and active lifestyle examples, presented as project directions rather than stock.",
      label: "Pending image slot for verified sportswear collection styles",
    },
  },
  {
    id: "sportswear-fabric",
    number: "03",
    rail: "Fabric",
    title: "Choose Fabric for Movement, Comfort, and the Intended Use",
    lead: "Choose fabric against the garment, activity, climate, hand feel, opacity, stretch, decoration, and intended shape. A compression top and a relaxed warm-up pant require different behavior; a generic performance label does not settle the decision.",
    tone: "light",
    items: [
      {
        title: "Knits for Tops, Jerseys, and Stretch Styles",
        body: "Candidate knits include polyester jersey, interlock, polyester-spandex blends, cotton blends, and mesh. Compare face and reverse, stretch, recovery, weight, drape, hand feel, and color. For close fits, also review opacity, support, and skin feel.",
      },
      {
        title: "Wovens for Shorts, Pants, and Lightweight Layers",
        body: "Possible woven directions include lightweight polyester, nylon, stretch woven, and ripstop. Select against the product and silhouette, then check noise, drape, stretch, skin contact, pocket load, and compatibility with waistbands, trims, panels, and decoration.",
      },
      {
        title: "Define Performance Targets Before Using Performance Claims",
        body: "If moisture management, quick drying, breathability, UV protection, water resistance, or another function matters, define the target and test method. A fabric name does not prove performance; publish a claim only after the requirement and supporting result are confirmed.",
      },
    ],
    media: {
      title: "Fabric decision references",
      detail: "Needed: verified knit, mesh, stretch, and woven swatches with face and reverse views.",
      label: "Pending image slot for verified sportswear fabric swatches",
    },
  },
  {
    id: "sportswear-fit",
    number: "04",
    rail: "Fit",
    title: "Get the Athletic Fit Right Before Sampling",
    lead: "Judge sportswear on the body and in motion. Choose the intended fit, sample size, and measurements that control movement and appearance. This is more useful than relying on labels such as slim, athletic, or relaxed.",
    tone: "ink",
    items: [
      {
        title: "Match the Fit to the Customer and Activity",
        body: "Describe the wearer, activity, layering needs, and silhouette. Compression, slim, athletic, regular, or relaxed are starting points, not specifications. Reference measurements or a physical garment make chest, waist, seat, thigh, sleeve, and body proportions clearer.",
      },
      {
        title: "Identify the Measurements That Control the Garment",
        body: "For tops, define chest, shoulder, armhole, sleeve, body length, and openings. For bottoms, define waist, hip, rise, thigh, inseam, outseam, and leg opening. Mark any point critical to coverage, movement, or styling.",
      },
      {
        title: "Review the Full Size Range, Not Only One Sample",
        body: "A sample shows one size; the order must work across the range. Provide the size chart, grading rules, and fit model information where available. Confirm measurements, tolerances, and size relationships before bulk rather than assuming the sample scales automatically.",
      },
    ],
    media: {
      title: "Fit and movement review",
      detail: "Needed: verified flat measurement and on-body front, side, and back fit review images.",
      label: "Pending image slot for a verified sportswear fit review",
    },
  },
  {
    id: "sportswear-details",
    number: "05",
    rail: "Details",
    title: "Build in the Details That Make the Garment Work",
    lead: "Construction should solve a wearer need. Mark where movement, ventilation, storage, adjustment, or reinforcement matters. Every added component affects sampling, cost, and production.",
    tone: "light",
    items: [
      {
        title: "Sleeves, Panels, Gussets, and Seams",
        body: "Possible directions include raglan or set-in sleeves, mesh zones, side panels, and gussets. Mark their shapes and positions. Define any required flat seams, bonded areas, reinforcement, or reduced-friction construction.",
      },
      {
        title: "Waistbands, Drawcords, Liners, and Openings",
        body: "For bottoms, define waistband depth, elastic behavior, drawcord position, liner, rise, inseam, and leg opening. For tops, confirm neck, cuff, hem, and front opening. Show how each should fit during relevant movement or layering.",
      },
      {
        title: "Pockets and Secure Storage",
        body: "State what each pocket must hold and where it should be reached. Side, back, hidden, and zippered pockets affect construction and comfort. Define opening size, bag depth, closure, placement, and reinforcement for the intended item.",
      },
      {
        title: "Trims, Reflective Details, and Wearer Contact",
        body: "List each zipper, puller, elastic, cord, stopper, binding, tape, and reflective component. Confirm color, size, finish, placement, and skin contact. Treat reflective material as a specified component, not an automatic safety guarantee.",
      },
    ],
    media: {
      title: "Functional construction details",
      detail: "Needed: verified close-ups of panels, gussets, waistbands, pockets, zippers, drawcords, and reflective details.",
      label: "Pending image slot for verified sportswear construction details",
    },
  },
  {
    id: "sportswear-branding",
    number: "06",
    rail: "Branding",
    title: "Make the Branding Work With the Fabric and the Order",
    lead: "Artwork is part of the specification. Send its source file, colors, dimensions, position, coverage, and intended appearance. The suitable route depends on fabric, stretch, construction, quantity, and expected result.",
    tone: "ink",
    items: [
      {
        title: "Sublimation and All-Over Artwork",
        body: "Sublimation may suit some polyester-based styles with large graphics, numbers, or color transitions. Confirm panels, artwork scale, color references, seam alignment, and size variation. Check material suitability and finished color for the project.",
      },
      {
        title: "Prints, Transfers, and Reflective Graphics",
        body: "Screen print, heat transfer, DTF, DTG, silicone, and reflective graphics are candidate methods. Review fabric surface, stretch, artwork detail, hand feel, coverage, placement, and quantity. Check the selected method during sampling.",
      },
      {
        title: "Embroidery, Badges, and Placement",
        body: "Embroidery and badges add weight, stiffness, backing, and possible skin contact. Define size, materials, position, edge finish, and reverse-side expectation. Review distortion and comfort before approving lightweight or high-stretch placements.",
      },
      {
        title: "Labels, Hangtags, Barcodes, and Packing Identity",
        body: "Private label inputs can include main, size, care, or heat-transfer labels, hangtags, stickers, barcodes, bags, and carton marks. Provide final files, wording, dimensions, materials, attachment points, and market requirements for sample and packing review.",
      },
    ],
    media: {
      title: "Branding and private label details",
      detail: "Needed: verified decoration, reflective detail, label, hangtag, and retail packing examples.",
      label: "Pending image slot for verified sportswear branding examples",
    },
  },
  {
    id: "sportswear-moq",
    number: "07",
    rail: "MOQ",
    title: "What Will Determine the MOQ and Quote for Your Sportswear?",
    lead: "A useful MOQ needs a defined product. Order structure, fabric, colors, sizes, decoration, trims, labels, packing, and development work affect how a project can be arranged. A complete brief makes the quotation more specific.",
    tone: "light",
    items: [
      {
        title: "Style, Color, Size, and Quantity Breakdown",
        body: "State total quantity and the split by style, color, and size. A coordinated set differs from several unrelated pieces sharing a logo. Include expected repeat orders, replacements, or personalized team units when the order structure is reviewed.",
      },
      {
        title: "Fabric, Decoration, and Custom Component Factors",
        body: "Custom-dyed fabric, special trims, wide artwork, personalized names, multiple print versions, and branded packing can affect minimums and cost. Mark essential elements and acceptable alternatives so the quotation can separate the core product from optional details.",
      },
      {
        title: "What to Send for a More Useful Quote",
        body: "Send the product, tech pack or reference, fabric direction, colors, sizes, quantity split, artwork, labels, packing, destination, target timing, and open decisions. Confirm MOQ, price, sample terms, and production timing for that specification.",
      },
    ],
  },
  {
    id: "sportswear-sample",
    number: "08",
    rail: "Sample",
    title: "Test the Sample in Motion Before Bulk Production",
    lead: "The sample makes assumptions visible. Put it on the intended wearer, move in it, measure it, inspect the details, and compare it with the brief. Record specific changes instead of broad feedback.",
    tone: "ink",
    items: [
      {
        title: "Review Fit During the Intended Movements",
        body: "Use movements relevant to the garment: lifting, bending, squatting, running, stretching, or layering. Check restriction, riding up, gaping, twisting, pressure, coverage, and pocket movement. Record the wearer, sample size, action, and issue.",
      },
      {
        title: "Check Fabric, Construction, and Branding Together",
        body: "Review stretch, recovery, opacity, surface, seam comfort, panel position, waistband, closures, pockets, and decoration on one sample. Consider linked changes: moving a panel affects artwork placement, while changing fabric may alter fit and decoration behavior.",
      },
      {
        title: "Turn Comments Into an Approved Reference",
        body: "Mark revisions with a measurement, location, photo, or artwork reference. Keep the tech pack, comments, and physical sample aligned. The approved sample and specification become the bulk reference; unresolved points should remain visible.",
      },
    ],
    media: {
      title: "Sample review and approval",
      detail: "Needed: verified motion checks, measurement notes, artwork review, and an identified approval reference.",
      label: "Pending image slot for a verified sportswear sample review",
    },
  },
  {
    id: "sportswear-production",
    number: "09",
    rail: "Production",
    title: "From Approved Sample to Packed Sportswear: What Happens Next?",
    lead: "Bulk work should follow the approved sample, specification, and order. The production flow keeps materials, measurements, workmanship, branding, quantities, and packing connected to the buyer-approved reference.",
    tone: "light",
    items: [
      {
        title: "Confirm the Order Reference Before Production",
        body: "Align the approved sample, current specification, colors, materials, sizes, artwork, labels, packing, and quantities. Resolve version conflicts before work proceeds so the buyer and production team use the same product definition.",
      },
      {
        title: "Prepare Materials, Cutting, Sewing, and Decoration",
        body: "Depending on the garment, stages can include material preparation, cutting, panel preparation, sewing, decoration, finishing, and pressing. Keep approved measurements, panel alignment, stretch areas, and artwork placement visible at the relevant stage.",
      },
      {
        title: "Keep Useful Records at the Right Stage",
        body: "Buyers can request stage-specific photos, measurements, inspection information, packing details, or related documents. Agree what is needed and when. A short record tied to a decision is more useful than unlabelled photos received after completion.",
      },
      {
        title: "Finish, Fold, Pack, and Prepare for Shipment",
        body: "Confirm finishing, folding, individual packing, barcode or sticker placement, carton quantity, assortment, and carton marks. Agree shipping documents, destination requirements, and handoff responsibilities. Packing is part of the product handoff.",
      },
    ],
    media: {
      title: "Production flow",
      detail: "Needed: verified material preparation, cutting, sewing, decoration, finishing, and packing stages.",
      label: "Pending image slot for a verified sportswear production sequence",
    },
  },
  {
    id: "sportswear-quality",
    number: "10",
    rail: "Quality",
    title: "What Gets Checked Before Your Sportswear Ships?",
    lead: "Base checks on the approved sample and order specification. Define important measurements, appearance points, working details, quantities, and packing requirements. Agree any formal inspection method, tolerance, test, or report before production.",
    tone: "ink",
    items: [
      {
        title: "Measurements, Fit-Critical Points, and Workmanship",
        body: "Check measurements that control fit and movement across relevant sizes. Review seams, loose or skipped stitches, puckering, stress points, panel alignment, and symmetry. Acceptance rules and tolerances must come from the approved order specification.",
      },
      {
        title: "Stretch Areas, Openings, Pockets, and Trims",
        body: "Review waistbands, cuffs, openings, zippers, drawcords, pockets, gussets, and other working parts. Check attachment, operation, position, and appearance. Any performance test remains separate and follows the method and target agreed for the project.",
      },
      {
        title: "Color, Decoration, Labels, and Order Identity",
        body: "Compare colors, artwork, numbers, names, placements, labels, and trims with approved references. Match teamwear variations to the order list. Check care and size information, barcode or sticker data, and attachment position before packing.",
      },
      {
        title: "Quantities, Assortments, Cartons, and Handoff Records",
        body: "Verify quantities, size and color assortments, individual packing, carton contents, and carton marks against the order. Provide agreed inspection or packing information at the correct stage so the buyer can connect packed goods with the approved product.",
      },
    ],
    media: {
      title: "Quality and packing checks",
      detail: "Needed: verified measurement, workmanship, decoration, label, assortment, and carton-mark checks.",
      label: "Pending image slot for verified sportswear quality and packing checks",
    },
  },
  {
    id: "sportswear-faq",
    number: "11",
    rail: "FAQ",
    title: "Questions Buyers Ask Before Ordering Custom Sportswear",
    lead: "Use these questions to clarify the product before sampling and to separate project requirements from unverified performance or commercial assumptions.",
    tone: "light",
    items: [
      {
        title: "Can We Start With a Photo or Reference Garment?",
        body: "Yes. A photo, physical reference, or concept can start the review but does not replace the final specification. Add intended changes, measurements, fabric, artwork, quantity, labels, and packing. Sampling creates the reviewable product reference.",
      },
      {
        title: "Which Fabric Should We Choose for Our First Style?",
        body: "Begin with the garment, activity, fit, climate, hand feel, stretch, opacity, and decoration. Then compare candidate fabrics by composition, structure, weight, color, and project-specific performance requirements.",
      },
      {
        title: "Can We Request Moisture-Wicking, Quick-Dry, UPF, or Water Resistance?",
        body: "Include the target, intended claim, market, test method, and acceptance value. Testing and supporting documents must be confirmed for the selected material and order. Generic sportswear wording is not evidence.",
      },
      {
        title: "What Is the MOQ and How Long Will Sampling Take?",
        body: "Both depend on the product and order. Styles, quantity splits, fabric, custom components, decoration, personalization, packing, and revisions affect the answer. Share the brief to confirm MOQ, sample cost, revision terms, and timing.",
      },
      {
        title: "What Can We Review During Production and Packing?",
        body: "Buyers can request stage-linked photos, measurements, inspection information, packing details, or related documents. Agree the record, timing, and purpose before production. Unstructured images do not prove every requirement.",
      },
    ],
  },
  {
    id: "sportswear-brief",
    number: "12",
    rail: "Brief",
    title: "Send a Sportswear Brief That Can Move the Project Forward",
    lead: "A complete brief helps turn an early idea into a product review, sample plan, and project-specific quotation.",
    tone: "ink",
    items: [],
    paragraphs: [
      "Include the product and activity; target customer and fit; tech pack or reference; material and performance requirements; colors and sizes; quantity breakdown; construction and trims; artwork; labels and packing; destination; and target timing.",
      "Mark fixed decisions and open questions. Show any coordinated sets, personalized team units, or planned repeats. YAUUM can then identify missing inputs and confirm project-specific sampling, MOQ, quotation, production, checking, packing, and shipment-preparation details.",
    ],
    media: {
      title: "Sportswear project brief",
      detail: "Needed: a verified sample with a tech pack, swatches, artwork, labels, and packing reference.",
      label: "Pending image slot for a verified sportswear project brief",
    },
  },
];
---

<BaseLayout
  title="Custom Sportswear Manufacturer for Private Label Brands | YAUUM"
  description="Develop custom sportswear for private label brands. Review product styles, fabrics, fit, branding, MOQ, sampling, production, quality checks, and packing."
  canonical={page.url}
>
  <div class="sp-page">
    <section class="sp-hero" aria-labelledby="sp-title">
      <div class="sp-shell sp-hero-grid">
        <div class="sp-hero-copy">
          <p class="sp-kicker">B2B / PRIVATE LABEL / SAMPLE-FIRST</p>
          <h1 id="sp-title">Custom Sportswear Manufacturer for Private Label Brands</h1>
          <p class="sp-hero-lead">Customize a sportswear range around the product, activity, fit, fabric, construction, branding, and order requirements your market needs. YAUUM uses a sample-first process so your team can review the garment, record changes, and approve a reference before bulk production.</p>
          <p class="sp-hero-note">Start with a tech pack, reference garment, product photo, or early concept. Define the wearer, use, quantity, size split, artwork, packing, destination, and target timing to make the first review and quotation more useful.</p>
          <div class="sp-hero-actions">
            <a class="sp-button" href="/contact-us/">Start your sportswear project</a>
            <a class="sp-link" href="#sportswear-products">Review product options</a>
          </div>
          <div class="sp-signals" aria-label="Sportswear development steps">
            <span><strong>01</strong> Product and use</span>
            <span><strong>02</strong> Sample and approval</span>
            <span><strong>03</strong> Bulk and handoff</span>
          </div>
        </div>
        <div class="sp-placeholder sp-placeholder-hero" role="img" aria-label="Pending image slot for a verified private label sportswear range">
          <span>IMAGE PLACEHOLDER</span>
          <strong>Private label sportswear range</strong>
          <small>Needed: verified training top, shorts, joggers, and track layer from confirmed projects.</small>
        </div>
      </div>
    </section>

    <nav class="sp-rail" aria-label="Sportswear page sections">
      <div class="sp-rail-inner">
        {sections.map(section => <a href={`#${section.id}`}><span>{section.number}</span>{section.rail}</a>)}
      </div>
    </nav>

    {sections.map(section => (
      <section class:list={["sp-section", `sp-section-${section.tone}`]} id={section.id} aria-labelledby={`${section.id}-title`}>
        <div class="sp-shell">
          <div class="sp-section-grid">
            <header class="sp-section-heading">
              <p class="sp-kicker">{section.number} / {section.rail}</p>
              <h2 id={`${section.id}-title`}>{section.title}</h2>
              <p>{section.lead}</p>
            </header>
            {section.items.length > 0 ? (
              <div class="sp-items">
                {section.items.map((item, index) => (
                  <article class="sp-item">
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    <h3>{item.title}</h3>
                    <p>{item.body}</p>
                  </article>
                ))}
              </div>
            ) : (
              <div class="sp-brief-copy">
                {section.paragraphs?.map(paragraph => <p>{paragraph}</p>)}
              </div>
            )}
          </div>
          {section.media && (
            <div class="sp-placeholder" role="img" aria-label={section.media.label}>
              <span>IMAGE PLACEHOLDER</span>
              <strong>{section.media.title}</strong>
              <small>{section.media.detail}</small>
            </div>
          )}
          {section.id === "sportswear-brief" && (
            <div class="sp-final-action">
              <p>Ready to review the product decisions behind your first sample?</p>
              <a class="sp-button" href="/contact-us/">Start your sportswear project</a>
            </div>
          )}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .sp-page {
    --sp-ink: #101514;
    --sp-dark: #111817;
    --sp-paper: #f4f6f2;
    --sp-white: #ffffff;
    --sp-muted: #5b6561;
    --sp-line: #d7ded9;
    --sp-accent: #c9f227;
    --sp-signal: #ff6b4a;
    background: var(--sp-paper);
    color: var(--sp-ink);
  }

  .sp-page * { box-sizing: border-box; }
  .sp-shell { width: min(1120px, calc(100% - 96px)); margin-inline: auto; }

  .sp-hero {
    background: var(--sp-dark);
    color: var(--sp-white);
    padding: 76px 0 64px;
  }

  .sp-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(300px, .8fr);
    gap: 64px;
    align-items: center;
  }

  .sp-kicker {
    margin: 0 0 16px;
    color: #5f7e00;
    font: 700 11px/1.4 var(--font-mono, monospace);
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .sp-hero .sp-kicker,
  .sp-section-ink .sp-kicker { color: var(--sp-accent); }

  .sp-hero h1 {
    max-width: 780px;
    margin: 0;
    font: 650 64px/.98 var(--font-display, sans-serif);
    letter-spacing: 0;
  }

  .sp-hero-lead {
    max-width: 720px;
    margin: 26px 0 0;
    color: #eef4ef;
    font-size: 18px;
    line-height: 1.65;
  }

  .sp-hero-note {
    max-width: 680px;
    margin: 16px 0 0;
    color: #aeb9b3;
    font-size: 14px;
    line-height: 1.7;
  }

  .sp-hero-actions { display: flex; flex-wrap: wrap; gap: 18px; align-items: center; margin-top: 28px; }
  .sp-button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    padding: 13px 19px;
    border: 1px solid var(--sp-accent);
    border-radius: 4px;
    background: var(--sp-accent);
    color: #162000;
    font-size: 13px;
    font-weight: 750;
    line-height: 1.2;
    text-decoration: none;
  }
  .sp-button:hover { background: #ddff56; border-color: #ddff56; }
  .sp-link { color: #f4f7f5; font-size: 13px; text-underline-offset: 4px; }

  .sp-signals {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 720px;
    margin-top: 34px;
    border-top: 1px solid #35403b;
    border-bottom: 1px solid #35403b;
  }
  .sp-signals span { padding: 14px 12px 14px 0; color: #b9c3bd; font-size: 11px; line-height: 1.35; }
  .sp-signals strong { display: block; margin-bottom: 5px; color: var(--sp-signal); font-family: var(--font-mono, monospace); }

  .sp-placeholder {
    display: grid;
    min-height: 260px;
    margin-top: 48px;
    place-content: center;
    justify-items: center;
    gap: 10px;
    padding: 32px;
    border: 1px dashed #93a198;
    background: #e9eeea;
    text-align: center;
  }
  .sp-placeholder-hero { min-height: 520px; margin-top: 0; background: #1c2522; border-color: #536159; }
  .sp-placeholder span { color: #4f6f00; font: 700 10px/1.4 var(--font-mono, monospace); letter-spacing: 0; }
  .sp-placeholder strong { max-width: 520px; font: 650 23px/1.15 var(--font-display, sans-serif); letter-spacing: 0; }
  .sp-placeholder small { max-width: 580px; color: #67736c; font-size: 12px; line-height: 1.55; }
  .sp-placeholder-hero span { color: var(--sp-accent); }
  .sp-placeholder-hero strong { color: #fff; }
