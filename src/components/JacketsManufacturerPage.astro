---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/jackets-manufacturer.css";
import type { WebsitePage } from "../lib/content";

interface Props { page: WebsitePage; }
type ContentItem = { title: string; body: string; };
type MediaSlot = { code: string; title: string; request: string; };

const { page } = Astro.props;

const railLinks = [
  ["#jacket-types", "Styles"], ["#jacket-materials", "Materials"],
  ["#jacket-fit", "Fit & details"], ["#jacket-branding", "Branding"],
  ["#jacket-moq", "MOQ"], ["#jacket-sampling", "Sampling"],
  ["#jacket-production", "Production"], ["#jacket-quality", "Quality"],
  ["#jacket-faq", "FAQ"], ["#jacket-brief", "Your brief"],
];

const jacketStyles = [
  {
    title: "Bomber Jackets: Shape and Finish",
    body: "A bomber is defined by its body length, sleeve volume, front closure, and often its ribbed cuffs and hem. Show the proportions you want in a reference photo; a fabric name alone will not define the finished silhouette.",
    media: { code: "01A", title: "Bomber jacket silhouette", request: "Full front, side, and back views from a confirmed project" },
  },
  {
    title: "Varsity Jackets: Contrast and Branding",
    body: "Decide how the body, sleeves, ribbing, and patches should work together. Mark the size and position of letters or badges on the artwork. Leather sleeves require a separate sourcing and material review.",
    media: { code: "01B", title: "Varsity jacket details", request: "Confirmed body, sleeve, rib, closure, and patch combination" },
  },
  {
    title: "Windbreakers: Light Layers with a Purpose",
    body: "Start with the intended season and wearing conditions, then specify the shell feel, lining, hood, cuffs, and pocket arrangement. A weather-related design direction is not a verified water- or wind-resistance claim.",
    media: { code: "01C", title: "Lightweight windbreaker", request: "Full garment plus hood, cuff, and pocket views" },
  },
  {
    title: "Puffer Jackets: Volume, Quilting, and Fill",
    body: "The same outer shape can look very different with another quilt pattern or fill distribution. Set the desired volume, length, hood, and closure in the brief. Down content or warmth claims require supporting material information and testing.",
    media: { code: "01D", title: "Puffer volume and quilting", request: "Confirmed full garment showing loft and quilt direction" },
  },
];

const materialItems: ContentItem[] = [
  { title: "Choose the Shell by Look and Use", body: "Nylon, polyester, twill, canvas, and denim are useful material directions to discuss. Specify the surface, hand feel, color, and intended use; composition and availability are reviewed for the chosen jacket." },
  { title: "Decide What the Wearer Feels Inside", body: "A mesh, woven, fleece, or quilted lining changes the jacket's interior and construction. Review the lining with the shell and fit, particularly around the sleeves, hood, and pockets, where added layers affect bulk." },
  { title: "Define the Fill and Any Performance Target", body: "For an insulated style, specify the intended fill type, distribution, and finished volume. Fill composition, weight, source, and leakage expectations need to be documented for the selected project. If the brief calls for water resistance, breathability, or warmth, agree on the requirement and test method before making a performance claim." },
];

const fitItems: ContentItem[] = [
  { title: "Start with Proportions, Not a Fit Label", body: "Relaxed or oversized can mean different things to different teams. Provide a reference garment or measurements for the chest, shoulders, body length, sleeves, and hem so the sample has a clear fit target." },
  { title: "Make the Closure Work with the Design", body: "A zipper, buttons, snaps, or a covered placket changes both appearance and construction. Review the collar or hood shape, cuff finish, and closure details together; a small change here can alter the jacket's front view." },
  { title: "Put Pockets Where They Belong", body: "Decide whether pockets are for storage, appearance, or both. Their size, position, opening, and fastening should be visible on the drawing or sample, alongside any specified pullers, drawcords, or other hardware." },
];

const brandingItems: ContentItem[] = [
  { title: "Choose Decoration for the Actual Shell", body: "Send artwork with its dimensions, colors, and intended placement. Printing or embroidery suitability depends on the selected material, construction, design size, and quantity; the method should be reviewed against the jacket rather than chosen from a generic menu." },
  { title: "Use Patches Without Losing the Silhouette", body: "A chest badge, sleeve patch, or larger back design changes how the jacket reads at a distance. Check scale and attachment position on a sample, particularly where seams, pockets, quilting, or lining may interfere." },
  { title: "Carry the Brand Through to the Details", body: "Specify the main label, size and care labels, hangtag, and any barcode or packing artwork in the brief. Confirm their content, placement, and project scope before the order specification is finalized." },
];

const moqItems: ContentItem[] = [
  { title: "Start with Quantity by Style and Color", body: "Give a separate quantity for each jacket style and color, plus the proposed size breakdown. A total such as 500 jackets cannot answer the MOQ question if it covers several shells, colorways, or constructions." },
  { title: "Account for Materials and Custom Details", body: "Specially sourced fabrics, linings, hardware, labels, and decoration can each affect the workable minimum. If flexibility matters, state which features are essential and which could be adjusted during project review. MOQ, sample terms, and production timing are then confirmed against the actual specification rather than a universal number." },
];

const samplingItems: ContentItem[] = [
  { title: "Give the First Sample a Clear Job", body: "Identify what must be decided from the sample: fit, shell and lining, pocket placement, closure function, branding, or all of them. Attach measurements and reference images so comments point to a specific requirement. If some materials are provisional, label them clearly instead of treating the sample as final in every respect." },
  { title: "Record Changes Before Approving Bulk Details", body: "Compare the sample with the brief, list requested changes, and check the revised details against the specification. Sample cost, timing, and revision terms are project-specific. The confirmed sample and written details then provide the reference for the next stage." },
];

const productionItems = [
  { title: "Confirm the Order Details", body: "Before bulk work, align the approved reference with the material, color, size breakdown, hardware, decoration, labels, and packing instructions. Review destination and timing requirements with the order information. An unresolved substitution or missing file should remain an open point, not an assumption.", media: { code: "07A", title: "Material and trim preparation", request: "Confirmed shell, lining, hardware, and labels arranged for review" } },
  { title: "Follow the Jacket Through Production", body: "The project workflow moves through material review, bulk production, inspection, folding, and packing. The exact operations depend on the jacket: a lined or quilted design has different construction points from a light shell. Key operations such as pocket alignment, zipper setting, quilting, and decoration should be tied to the approved reference.", media: { code: "07B", title: "Jacket production stage", request: "Confirmed cutting, sewing, zipper setting, quilting, or decoration process" } },
  { title: "Ask for Information at the Useful Stage", body: "Buyers can request relevant photos, measurements, packing information, or documents during the project. Agree on what is needed and when it can be provided, so a photo or record answers a specific approval question. Clearly identified records are more useful than images without order, size, color, or stage context.", media: { code: "07C", title: "Production-stage record", request: "Dated measurement, workmanship, or order-stage record with sensitive data removed" } },
];

const qualityItems = [
  { title: "Fit, Measurements, and Symmetry", body: "Set the size chart and agreed tolerances for the order. Inspection points can include chest, shoulder, body and sleeve measurements, plus the alignment of front panels, pockets, and other paired details. The collar, hood, cuffs, and hem can also be compared with the approved shape and construction.", media: { code: "08A", title: "Measurement and symmetry check", request: "Confirmed jacket laid flat with visible measurement method" } },
  { title: "Construction and Branding Details", body: "Check specified zippers, snaps, stitching, quilting, print or embroidery placement, and patch attachment against the approved reference. For filled jackets, distribution and leakage may need attention. Washed or distressed effects may require an agreed visual range, while test-dependent requirements must be confirmed separately.", media: { code: "08B", title: "Closure and workmanship check", request: "Close views of zipper, snaps, seams, quilting, or applied branding" } },
  { title: "Labels, Quantities, and Packing", body: "Match labels, size assortments, unit packing, carton counts, and carton marks to the order instructions. Barcode or retail information should be checked against buyer-provided data before cartons are closed. The inspection method and acceptance rules are agreed for the project rather than presented as one universal standard.", media: { code: "08C", title: "Packing and carton verification", request: "Confirmed folding, unit bag, size sticker, carton count, and carton mark" } },
];

const faqs = [
  { question: "Can I start with a photo instead of a tech pack?", answer: "A reference photo can start the brief. Measurements, material composition, construction, and branding still need to be defined before the photo becomes a usable sampling specification. Mark which elements should be followed and which should change, especially when the reference belongs to another brand." },
  { question: "Can I request leather or down?", answer: "Include either requirement in the inquiry so sourcing and documentation can be reviewed. Leather type and source, or down composition and source, need a feasibility review and supporting information before the material, quote, or product claim is finalized. PU or synthetic fill should also be identified precisely rather than treated as automatic substitutes." },
  { question: "What is the jacket MOQ and sample time?", answer: "MOQ and sample timing are quoted to the project. Share the style, quantity split, materials, and custom details so the applicable minimum and sample terms can be reviewed. Material availability, custom components, and revision scope all need to be understood before timing is confirmed." },
  { question: "Can I specify waterproof or other performance requirements?", answer: "Yes, as a target in the brief. Define the required result, test method, and supporting report. A finish or material description alone does not establish a verified performance rating. Also identify the intended market and use because construction and labeling requirements may extend beyond the shell material itself." },
  { question: "Can I request photos or measurements during production?", answer: "These can be requested at relevant project stages. Specify which details you need to review and agree on the available records for that order. State the required size, color, angle, measurement point, or packing stage so the requested information can be connected to the correct item." },
];

const briefItems = ["Jacket type or reference garment", "Season, use case, and destination market", "Size range and key measurements", "Target shell, lining, and fill", "Artwork, labels, and hardware details", "Quantity by style, color, and size", "Packing requirements and target timing"];

const mediaSlots: Record<string, MediaSlot> = {
  hero: { code: "HERO", title: "Confirmed jacket project", request: "Full front-view jacket with a clear silhouette and visible construction" },
  shell: { code: "02A", title: "Shell swatch comparison", request: "Confirmed shell faces showing texture, finish, and color direction" },
  layers: { code: "02B", title: "Shell, lining, and fill layers", request: "Confirmed material stack or opened interior showing the complete build" },
  details: { code: "03", title: "Fit and construction details", request: "Collar, hood, cuff, closure, pocket, and hardware close views" },
  decoration: { code: "04A", title: "Decoration applications", request: "Confirmed print, embroidery, or patch examples on jacket shells" },
  labels: { code: "04B", title: "Private label set", request: "Main, size, care, hangtag, and packing details from one project" },
  moq: { code: "05", title: "Material and trim review", request: "Confirmed shell, lining, hardware, label, and decoration set" },
  sampling: { code: "06", title: "Sample review and approval", request: "Confirmed sample with measurement sheet and revision notes" },
};

const faqJsonLd = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map(item => ({ "@type": "Question", name: item.question, acceptedAnswer: { "@type": "Answer", text: item.answer } })) };
---

<BaseLayout title="Custom Jacket Manufacturer for Private Label Brands | YAUUM" description="Plan a private label jacket by style, shell, lining, fill, fit, branding, MOQ factors, sampling, production, quality checks, and packing requirements." canonical={page.url} jsonLd={faqJsonLd}>
  <div class="jacket-page">
    <section class="jacket-hero" aria-labelledby="jacket-title">
      <div class="jacket-shell jacket-hero-grid">
        <div class="jacket-hero-copy">
          <p class="jacket-kicker">B2B / PRIVATE LABEL / PROJECT DEVELOPMENT</p>
          <h1 id="jacket-title">Custom Jacket Manufacturer for Private Label Brands</h1>
          <p class="jacket-hero-lead">A jacket starts with a clear use case: who will wear it, in which season, and what should make it distinct? Bring a reference or tech pack to define the style, materials, fit, branding, quantity, and packing requirements for the chosen project.</p>
          <div class="jacket-actions"><a class="jacket-button" href="/contact-us/">Start your jacket brief</a><a class="jacket-text-link" href="#jacket-types">Compare jacket styles</a></div>
          <dl class="jacket-signals"><div><dt>01</dt><dd>Define the product</dd></div><div><dt>02</dt><dd>Review the sample</dd></div><div><dt>03</dt><dd>Approve the reference</dd></div></dl>
        </div>
        <figure class="jacket-media jacket-media-hero"><div class="jacket-media-field"><span>{mediaSlots.hero.code}</span><strong>{mediaSlots.hero.title}</strong></div><figcaption>{mediaSlots.hero.request}<small>needs_company_confirmation</small></figcaption></figure>
      </div>
    </section>

    <nav class="jacket-rail" aria-label="Jacket page sections"><div class="jacket-shell jacket-rail-inner">{railLinks.map(([href, label]) => <a href={href}>{label}</a>)}</div></nav>

    <section class="jacket-section jacket-section-light" id="jacket-types" aria-labelledby="jacket-types-title">
      <div class="jacket-shell">
        <div class="jacket-section-head"><div><p class="jacket-kicker">01 / START WITH THE PRODUCT</p><h2 id="jacket-types-title">Bomber, Varsity, Windbreaker or Puffer: Which Fits Your Collection?</h2></div><p>These are starting points for a product brief, not a stock catalog. Think first about the customer, retail season, target price, and how the jacket will be worn. The selected direction can then be reviewed for the project.</p></div>
        <div class="jacket-style-grid">{jacketStyles.map((item, index) => <article class="jacket-style-item"><figure class="jacket-media jacket-media-style"><div class="jacket-media-field"><span>{item.media.code}</span><strong>{item.media.title}</strong></div><figcaption>{item.media.request}<small>needs_company_confirmation</small></figcaption></figure><span class="jacket-index">0{index + 1}</span><h3>{item.title}</h3><p>{item.body}</p></article>)}</div>
      </div>
    </section>

    <section class="jacket-section jacket-section-dark" id="jacket-materials" aria-labelledby="jacket-materials-title">
      <div class="jacket-shell">
        <div class="jacket-section-head"><div><p class="jacket-kicker">02 / BUILD THE MATERIAL SYSTEM</p><h2 id="jacket-materials-title">Build for the Season: Shell, Lining and Fill</h2></div><p>Treat the jacket as a material system. State the climate, wearing situation, target hand feel, and care expectations so the shell, lining, fill, and any performance target can be reviewed against the same purpose.</p></div>
        <div class="jacket-copy-grid jacket-copy-grid-three">{materialItems.map((item, index) => <article><span class="jacket-index">0{index + 1}</span><h3>{item.title}</h3><p>{item.body}</p></article>)}</div>
        <div class="jacket-media-grid jacket-media-grid-two">{[mediaSlots.shell, mediaSlots.layers].map(slot => <figure class="jacket-media"><div class="jacket-media-field"><span>{slot.code}</span><strong>{slot.title}</strong></div><figcaption>{slot.request}<small>needs_company_confirmation</small></figcaption></figure>)}</div>
      </div>
    </section>

    <section class="jacket-section jacket-section-light" id="jacket-fit" aria-labelledby="jacket-fit-title">
      <div class="jacket-shell jacket-split"><div><p class="jacket-kicker">03 / SHAPE AND FUNCTION</p><h2 id="jacket-fit-title">Get the Silhouette Right: Fit, Closures and Pockets</h2><p class="jacket-lead">The silhouette depends on connected decisions about body width, shoulder position, sleeve volume, length, hem shape, and material structure. A clear measurement set makes sample comments more useful than fit labels alone.</p><figure class="jacket-media jacket-media-tall"><div class="jacket-media-field"><span>{mediaSlots.details.code}</span><strong>{mediaSlots.details.title}</strong></div><figcaption>{mediaSlots.details.request}<small>needs_company_confirmation</small></figcaption></figure></div><div class="jacket-copy-stack">{fitItems.map((item, index) => <article><span class="jacket-index">0{index + 1}</span><h3>{item.title}</h3><p>{item.body}</p></article>)}</div></div>
    </section>

    <section class="jacket-section jacket-section-warm" id="jacket-branding" aria-labelledby="jacket-branding-title">
      <div class="jacket-shell">
        <div class="jacket-section-head"><div><p class="jacket-kicker">04 / BRAND THE GARMENT</p><h2 id="jacket-branding-title">Make It Yours: Prints, Embroidery, Patches and Labels</h2></div><p>Decoration should strengthen the product rather than look added at the last moment. Place each artwork element on a garment drawing and provide its actual dimensions so feasibility can be reviewed before sampling.</p></div>
        <div class="jacket-copy-grid jacket-copy-grid-three">{brandingItems.map((item, index) => <article><span class="jacket-index">0{index + 1}</span><h3>{item.title}</h3><p>{item.body}</p></article>)}</div>
        <div class="jacket-media-grid jacket-media-grid-two">{[mediaSlots.decoration, mediaSlots.labels].map(slot => <figure class="jacket-media jacket-media-light"><div class="jacket-media-field"><span>{slot.code}</span><strong>{slot.title}</strong></div><figcaption>{slot.request}<small>needs_company_confirmation</small></figcaption></figure>)}</div>
      </div>
    </section>

    <section class="jacket-section jacket-section-light" id="jacket-moq" aria-labelledby="jacket-moq-title">
      <div class="jacket-shell jacket-split jacket-split-reverse"><figure class="jacket-media jacket-media-tall"><div class="jacket-media-field"><span>{mediaSlots.moq.code}</span><strong>{mediaSlots.moq.title}</strong></div><figcaption>{mediaSlots.moq.request}<small>needs_company_confirmation</small></figcaption></figure><div><p class="jacket-kicker">05 / QUANTITY AND COMPLEXITY</p><h2 id="jacket-moq-title">What Determines the MOQ for Your Jacket?</h2><p class="jacket-lead">MOQ can be affected by fabric availability, custom colors, lining, fill, hardware, developed trims, decoration, and the order split. A useful discussion starts with the complete jacket rather than a universal number.</p><div class="jacket-copy-stack jacket-copy-stack-compact">{moqItems.map((item, index) => <article><span class="jacket-index">0{index + 1}</span><h3>{item.title}</h3><p>{item.body}</p></article>)}</div></div></div>
    </section>

    <section class="jacket-section jacket-section-teal" id="jacket-sampling" aria-labelledby="jacket-sampling-title">
      <div class="jacket-shell jacket-split"><div><p class="jacket-kicker">06 / SAMPLE BEFORE BULK</p><h2 id="jacket-sampling-title">See It Before Bulk: Jacket Sampling and Approval</h2><p class="jacket-lead">Use the sample to judge the complete garment, not only whether it resembles the reference. Fit, movement, materials, pocket access, closure function, artwork scale, labels, and finishing should be reviewed against the same brief.</p><div class="jacket-copy-stack jacket-copy-stack-compact">{samplingItems.map((item, index) => <article><span class="jacket-index">0{index + 1}</span><h3>{item.title}</h3><p>{item.body}</p></article>)}</div></div><figure class="jacket-media jacket-media-tall jacket-media-on-teal"><div class="jacket-media-field"><span>{mediaSlots.sampling.code}</span><strong>{mediaSlots.sampling.title}</strong></div><figcaption>{mediaSlots.sampling.request}<small>needs_company_confirmation</small></figcaption></figure></div>
    </section>

    <section class="jacket-section jacket-section-dark" id="jacket-production" aria-labelledby="jacket-production-title">
      <div class="jacket-shell"><div class="jacket-section-head"><div><p class="jacket-kicker">07 / AFTER APPROVAL</p><h2 id="jacket-production-title">From Approved Sample to Packed Jackets: What Happens Next?</h2></div><p>Confirm what is fixed, what remains open, and which records the buyer needs later. Purchasing, production, inspection, and packing can then work from the same garment reference and order details.</p></div><div class="jacket-stage-list">{productionItems.map((item, index) => <article class="jacket-stage"><div class="jacket-stage-copy"><span class="jacket-index">0{index + 1}</span><h3>{item.title}</h3><p>{item.body}</p></div><figure class="jacket-media"><div class="jacket-media-field"><span>{item.media.code}</span><strong>{item.media.title}</strong></div><figcaption>{item.media.request}<small>needs_company_confirmation</small></figcaption></figure></article>)}</div></div>
    </section>

    <section class="jacket-section jacket-section-light" id="jacket-quality" aria-labelledby="jacket-quality-title">
      <div class="jacket-shell"><div class="jacket-section-head"><div><p class="jacket-kicker">08 / INSPECTION AND PACKOUT</p><h2 id="jacket-quality-title">What Gets Checked Before Your Jackets Ship?</h2></div><p>Inspection should reflect the risks of the actual jacket. Define the measurement, appearance, construction, hardware, decoration, labeling, packing, and test-dependent requirements that matter to the approved order.</p></div><div class="jacket-quality-grid">{qualityItems.map((item, index) => <article><figure class="jacket-media jacket-media-quality"><div class="jacket-media-field"><span>{item.media.code}</span><strong>{item.media.title}</strong></div><figcaption>{item.media.request}<small>needs_company_confirmation</small></figcaption></figure><span class="jacket-index">0{index + 1}</span><h3>{item.title}</h3><p>{item.body}</p></article>)}</div></div>
    </section>

    <section class="jacket-section jacket-section-warm" id="jacket-faq" aria-labelledby="jacket-faq-title">
      <div class="jacket-shell jacket-faq-layout"><div><p class="jacket-kicker">09 / BUYER QUESTIONS</p><h2 id="jacket-faq-title">Before You Order: Answers to Common Jacket Questions</h2><p class="jacket-lead">Send the intended style, quantity, market, and decisions already made. Remaining questions can then be separated into sourcing, sampling, commercial terms, testing, and packing.</p></div><div class="jacket-faq-list">{faqs.map((item, index) => <details open={index === 0}><summary><span>0{index + 1}</span><h3>{item.question}</h3><i aria-hidden="true"></i></summary><p>{item.answer}</p></details>)}</div></div>
    </section>

    <section class="jacket-brief" id="jacket-brief" aria-labelledby="jacket-brief-title">
      <div class="jacket-shell jacket-brief-grid"><div><p class="jacket-kicker">10 / READY FOR REVIEW</p><h2 id="jacket-brief-title">Start with Your Jacket Brief</h2><p>Send the product direction and mark anything undecided. Clear inputs give the project review a useful starting point without treating an estimate as an approved specification.</p><a class="jacket-button jacket-button-dark" href="/contact-us/">Discuss your jacket project</a></div><ul>{briefItems.map(item => <li>{item}</li>)}</ul></div>
    </section>
  </div>
</BaseLayout>
