---
// InquiryForm.astro — the single site-wide inquiry form.
// MOQ tiers assume 1 design / 1 color / 5 sizes (site quoting basis).
// Endpoint: formsubmit.co bound to the footer email; first real submission
// triggers a one-time activation email. Switch to Formspree by replacing ENDPOINT.
interface Props {
  product?: string;
}
const { product = "General inquiry" } = Astro.props;
const ENDPOINT = "https://formsubmit.co/ajax/mumu@yauum.com"; // 收件/回件用
// 提交提醒（不回件）：QQ 邮箱通知 + WhatsApp 推送（CallMeBot，apikey 留空则静默跳过）
// 配置经 data-* 渲染进表单，客户端脚本只读 DOM——避免前端常量与打包作用域的坑。
const NOTIFY_EMAIL_ENDPOINTS = [
  "https://formsubmit.co/ajax/397740930@qq.com",
  "https://formsubmit.co/ajax/aisen@qyoure.com",
];
const WA_PHONE = "8615733728976";
const WA_APIKEY = ""; // CallMeBot 激活后填入，即可开启 WhatsApp 推送

const GARMENTS = ["Hoodies", "T-Shirts", "Jackets", "Pants", "Sportswear", "Streetwear", "Other"];
const PRESELECT: Record<string, string> = {
  "Custom clothing": "Hoodies",
  "About Us": "Other",
  "Our Services": "Other",
  Production: "Other",
  Solutions: "Other",
  Blog: "Other",
  "Contact Us": "Other",
};
const garment = PRESELECT[product] ?? (GARMENTS.includes(product) ? product : "Other");
const TIERS = ["300–500 pcs", "500–1,000 pcs", "1,000–2,000 pcs", "2,000+ pcs"];
---

<form
  class="inq-form"
  method="POST"
  action={ENDPOINT}
  data-product={product}
  data-notify-endpoint={NOTIFY_EMAIL_ENDPOINTS.join(",")}
  data-wa-phone={WA_PHONE}
  data-wa-key={WA_APIKEY}
>
  <input type="hidden" name="product" value={product} />
  <input type="hidden" name="_subject" value={`Yauum inquiry — ${product}`} />
  <input type="text" name="_honey" class="inq-honey" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="inq-field">
    <label for="inq-garment">Garment type</label>
    <select id="inq-garment" name="garment_type">
      {GARMENTS.map((g) => <option value={g} selected={g === garment}>{g}</option>)}
    </select>
  </div>

  <fieldset class="inq-field inq-tiers">
    <legend>Quantity <span>· 1 design · 1 color · 5 sizes</span></legend>
    <div class="inq-tier-grid">
      {TIERS.map((tier, i) => (
        <label class="inq-tier">
          <input type="radio" name="moq_tier" value={tier} checked={i === 0} />
          <span>{tier}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <div class="inq-row">
    <div class="inq-field">
      <label for="inq-name">Name</label>
      <input id="inq-name" name="name" type="text" required autocomplete="name" placeholder="Your name" />
    </div>
    <div class="inq-field">
      <label for="inq-email">Email</label>
      <input id="inq-email" name="email" type="email" required autocomplete="email" placeholder="you@company.com" />
    </div>
  </div>

  <div class="inq-field">
    <label for="inq-msg">Project details <span>(optional)</span></label>
    <textarea id="inq-msg" name="message" rows="3" placeholder="Style references or tech pack, fabric or GSM, branding and labels, target date…"></textarea>
  </div>

  <button class="inq-submit" type="submit">Send inquiry</button>
  <p class="inq-status" role="status" hidden></p>
</form>

<style>
  .inq-form {
    display: grid;
    gap: 14px;
    padding: 24px;
    background: var(--surface, #fff);
    border: 1px solid var(--line, #d9ded8);
    border-top: 2px solid var(--accent, #9bd63e);
    font-family: var(--font-body, Inter, sans-serif);
  }
  .inq-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .inq-field { display: grid; gap: 6px; min-width: 0; }
  .inq-field label,
  .inq-tiers legend {
    font-family: var(--font-mono, "IBM Plex Mono", monospace);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted, #626a63);
    padding: 0;
  }
  .inq-tiers legend span,
  .inq-field label span { text-transform: none; letter-spacing: 0; opacity: 0.85; }
  .inq-form select,
  .inq-form input,
  .inq-form textarea {
    width: 100%;
    padding: 11px 13px;
    border: 1px solid var(--line, #d9ded8);
    background: var(--surface, #fff);
    color: var(--fg, #171a17);
    font: 400 15px/1.4 var(--font-body, Inter, sans-serif);
    border-radius: 0;
  }
  .inq-form select {
    appearance: none;
    background-image: linear-gradient(45deg, transparent 49%, var(--fg, #171a17) 50%), linear-gradient(135deg, var(--fg, #171a17) 50%, transparent 51%);
    background-position: calc(100% - 20px) 50%, calc(100% - 14px) 50%;
    background-size: 6px 6px;
    background-repeat: no-repeat;
  }
  .inq-form textarea { resize: vertical; min-height: 72px; }
  .inq-form input:focus,
  .inq-form select:focus,
  .inq-form textarea:focus { outline: 2px solid var(--accent, #9bd63e); outline-offset: -1px; border-color: var(--accent, #9bd63e); }
  .inq-tier-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .inq-tier { position: relative; display: block; cursor: pointer; }
  .inq-tier input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .inq-tier span {
    display: flex; align-items: center; justify-content: center;
    min-height: 42px; padding: 9px 10px;
    border: 1px solid var(--line, #d9ded8);
    background: var(--surface, #fff);
    font: 500 14px var(--font-body, Inter, sans-serif);
    color: var(--fg, #171a17);
    text-align: center;
    transition: border-color 0.12s ease-out, background-color 0.12s ease-out;
  }
  .inq-tier input:checked + span { border-color: var(--accent, #9bd63e); background: var(--bg, #f4f5f1); box-shadow: inset 0 0 0 1px var(--accent, #9bd63e); font-weight: 600; }
  .inq-tier input:focus-visible + span { outline: 2px solid var(--accent, #9bd63e); outline-offset: 2px; }
  .inq-tier:hover span { border-color: var(--accent, #9bd63e); }
  .inq-submit {
    justify-self: start;
    padding: 13px 26px;
    background: var(--accent, #9bd63e);
    color: var(--accent-ink, #17210f);
    border: 0;
    font: 600 15px var(--font-body, Inter, sans-serif);
    cursor: pointer;
    border-radius: 0;
  }
  .inq-submit:hover { filter: brightness(1.05); }
  .inq-submit[disabled] { opacity: 0.6; cursor: wait; }
  .inq-status { margin: 0; font-size: 14px; color: var(--muted, #626a63); }
  .inq-status.is-ok { color: var(--fg, #171a17); }
  .inq-status.is-err { color: #8a2f2f; }
  .inq-honey { display: none; }
  @media (max-width: 640px) {
    .inq-row { grid-template-columns: 1fr; }
    .inq-submit { justify-self: stretch; }
  }
</style>

<script>
  /* 来源归因：记录"首次落地页"而非提交页——访客多半先落首页再逛到产品页。
     AI 来源（ChatGPT/Perplexity 等）常不传 referrer，必须同时看 utm_source。 */
  const ENTRY_KEY = "yauum_entry";
  const AI_SOURCES: Record<string, string> = {
    "chatgpt.com": "ChatGPT", "chat.openai.com": "ChatGPT", "openai.com": "ChatGPT",
    "perplexity.ai": "Perplexity", "gemini.google.com": "Gemini", "bard.google.com": "Gemini",
    "copilot.microsoft.com": "Copilot", "claude.ai": "Claude", "anthropic.com": "Claude",
    "grok.com": "Grok", "x.ai": "Grok", "you.com": "You.com", "phind.com": "Phind",
    "kagi.com": "Kagi", "poe.com": "Poe", "deepseek.com": "DeepSeek", "mistral.ai": "Mistral",
  };
  const SEARCH_SOURCES: Record<string, string> = {
    "google.com": "Google", "google.co.uk": "Google", "google.de": "Google", "google.fr": "Google",
    "bing.com": "Bing", "duckduckgo.com": "DuckDuckGo", "baidu.com": "Baidu",
    "yandex.com": "Yandex", "ecosia.org": "Ecosia", "search.brave.com": "Brave",
  };
  const SOCIAL_SOURCES: Record<string, string> = {
    "linkedin.com": "LinkedIn", "facebook.com": "Facebook", "instagram.com": "Instagram",
    "x.com": "X", "twitter.com": "X", "youtube.com": "YouTube", "pinterest.com": "Pinterest",
    "tiktok.com": "TikTok", "reddit.com": "Reddit",
  };
  const matchSource = (map: Record<string, string>, host: string, src: string) =>
    Object.keys(map).find((key) => host === key || host.endsWith("." + key) || src === key || src.startsWith(key.split(".")[0])) || "";

  try {
    if (!sessionStorage.getItem(ENTRY_KEY)) {
      sessionStorage.setItem(ENTRY_KEY, JSON.stringify({
        page: location.href,
        referrer: document.referrer || "",
        at: new Date().toISOString(),
      }));
    }
  } catch {
    /* 隐私模式下 sessionStorage 不可用：退化为只用当次提交的上下文 */
  }

  document.querySelectorAll<HTMLFormElement>(".inq-form").forEach((form) => {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const status = form.querySelector<HTMLParagraphElement>(".inq-status");
      const submit = form.querySelector<HTMLButtonElement>(".inq-submit");
      submit?.setAttribute("disabled", "");
      if (status) { status.hidden = true; status.className = "inq-status"; }
      try {
        const data = new FormData(form);
        const payload: Record<string, string> = {};
        data.forEach((value, key) => (payload[key] = String(value)));

        // 访客国家/城市：只用于邮件标题，失败不阻塞提交（超时 2.5s）
        let country = "";
        let city = "";
        try {
          const geo = await fetch("https://ipwho.is/", { signal: AbortSignal.timeout(2500) }).then((r) => r.json());
          if (geo && geo.success !== false) {
            country = geo.country || "";
            city = geo.city || "";
          }
        } catch {
          /* 取不到就留空，标题回落到"未知地区" */
        }

        // 来源归因：首次落地页 + 引荐 + 渠道归类（AI / 搜索 / 社交 / 外链 / 站内 / 直接）
        let entry: { page?: string; referrer?: string } = {};
        try {
          entry = JSON.parse(sessionStorage.getItem(ENTRY_KEY) || "{}");
        } catch {
          entry = {};
        }
        const referrer = entry.referrer || document.referrer || "";
        let host = "";
        try {
          host = referrer ? new URL(referrer).hostname.replace(/^www\./, "") : "";
        } catch {
          host = "";
        }
        // utm 参数通常挂在落地页上，提交页可能已经不带
        let params: URLSearchParams;
        try {
          params = new URL(entry.page || location.href).searchParams;
        } catch {
          params = new URLSearchParams();
        }
        const utmSource = (params.get("utm_source") || "").toLowerCase();
        const utmMedium = (params.get("utm_medium") || "").toLowerCase();
        const gclid = params.get("gclid") || params.get("gbraid") || params.get("wbraid") || "";

        let traffic: string;
        let channel: string;
        const ai = matchSource(AI_SOURCES, host, utmSource);
        const search = matchSource(SEARCH_SOURCES, host, utmSource);
        const social = matchSource(SOCIAL_SOURCES, host, utmSource);
        if (ai) {
          channel = "AI 推荐";
          traffic = `AI 推荐（${AI_SOURCES[ai]}）`;
        } else if (gclid || /cpc|paid|ppc/.test(utmMedium)) {
          channel = "付费搜索";
          traffic = `付费搜索（${search ? SEARCH_SOURCES[search] : "Google Ads"}）`;
        } else if (search) {
          channel = "自然搜索";
          traffic = `自然搜索（${SEARCH_SOURCES[search]}）`;
        } else if (social) {
          channel = "社交媒体";
          traffic = `社交媒体（${SOCIAL_SOURCES[social]}）`;
        } else if (/yauum\.com$/.test(host)) {
          channel = "站内跳转";
          traffic = `站内跳转（${host}）`;
        } else if (host) {
          channel = "外链";
          traffic = `外链（${host}）`;
        } else if (utmSource) {
          channel = "带参来源";
          traffic = `带参来源（utm_source=${utmSource}）`;
        } else {
          channel = "直接访问";
          traffic = "直接访问（或来源被 AI/浏览器隐藏）";
        }
        ["utm_source", "utm_medium", "utm_campaign", "gclid"].forEach((key) => {
          const value = params.get(key);
          if (value) traffic += ` · ${key}=${value}`;
        });

        payload["_subject"] = `🌳 Yauum网站来 ${country ? (city ? `${country}（${city}）` : country) : "未知地区"} 的询盘了！`;
        payload["_template"] = "table";
        payload["_replyto"] = payload["email"] || "";
        payload["country"] = country;
        payload["city"] = city;
        payload["traffic_source"] = traffic;
        payload["channel"] = channel;
        payload["entry_page"] = entry.page || location.href;
        payload["entry_referrer"] = referrer;
        payload["source_page"] = location.href;
        payload["garment_page"] = form.dataset.product || "";
        payload["submitted_at"] = new Date().toLocaleString("zh-CN", { timeZone: "Asia/Shanghai" }) + "（北京时间）";

        // 主收件（mumu@yauum.com）+ 通知抄送（397740930@qq.com）
        // 任一端点投递成功即视为成功——避免主邮箱待激活时丢掉线索。
        const notifyEndpoints = (form.dataset.notifyEndpoint || "")
          .split(",")
          .map((entry) => entry.trim())
          .filter(Boolean);
        const mailTargets = [form.action, ...notifyEndpoints];
        const mailResults = await Promise.allSettled(
          mailTargets.map(async (target) => {
            const res = await fetch(target, {
              method: "POST",
              headers: { "Content-Type": "application/json", Accept: "application/json" },
              body: JSON.stringify(payload),
            });
            const body = await res.json().catch(() => ({} as Record<string, unknown>));
            // formsubmit 用 HTTP 200 + success:"false" 表示未激活/被拒，必须看内容
            return res.ok && body.success !== "false" && body.success !== false;
          }),
        );
        const anyDelivered = mailResults.some((r) => r.status === "fulfilled" && r.value === true);
        if (!anyDelivered) throw new Error("all endpoints failed");

        // WhatsApp 推送（CallMeBot；未配置 apikey 时跳过）
        const waPhone = form.dataset.waPhone || "";
        const waKey = form.dataset.waKey || "";
        if (waKey && waPhone) {
          const text = `Yauum inquiry: ${payload.garment_type || ""} | ${payload.moq_tier || ""} | ${payload.name || ""} | ${payload.email || ""}`;
          fetch(`https://api.callmebot.com/whatsapp.php?phone=${waPhone}&apikey=${waKey}&text=${encodeURIComponent(text)}`, { mode: "no-cors" }).catch(() => {});
        }
        form.reset();
        if (status) { status.hidden = false; status.classList.add("is-ok"); status.textContent = "Thanks — your inquiry is on its way. We reply within one business day."; }
        if (window.gtag) window.gtag("event", "inquiry_form_submit", { product: form.dataset.product || "General", moq: payload.moq_tier || "" });
      } catch {
        if (status) { status.hidden = false; status.classList.add("is-err"); status.textContent = "Something went wrong — please email mumu@yauum.com instead."; }
      } finally {
        submit?.removeAttribute("disabled");
      }
    });
  });
</script>
