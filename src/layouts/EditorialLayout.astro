---
import Analytics from "../components/Analytics.astro";
import scriptHome from "../scripts/editorial/home.js?raw";
import scriptProductA from "../scripts/editorial/product-a.js?raw";
import scriptProductB from "../scripts/editorial/product-b.js?raw";
import SiteChromeTop from "../components/chrome/SiteChromeTop.astro";
import SiteChromeFooter from "../components/chrome/SiteChromeFooter.astro";

interface Props {
  title: string;
  description: string;
  canonical: string;
  jsonLd?: Record<string, unknown>[];
  variant?: "home" | "product-a" | "product-b";
  navCurrent?: string[];
  showMobileInquiry?: boolean;
}

const {
  title,
  description,
  canonical,
  jsonLd,
  variant = "product-a",
  navCurrent = [],
  showMobileInquiry = false,
} = Astro.props;

const mainId = variant === "home" ? "main" : "main-content";
const script =
  variant === "home" ? scriptHome : variant === "product-b" ? scriptProductB : scriptProductA;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600&display=swap" />
    {jsonLd?.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <Analytics />
  </head>
  <body>
    <SiteChromeTop
      mainId={mainId}
      navCurrent={navCurrent}
      variant={variant}
      showMobileInquiry={showMobileInquiry}
    />

<main id={mainId}>
      <slot />
    </main>

    <SiteChromeFooter navCurrent={navCurrent} />

<script is:inline set:html={script} />
  </body>
</html>
