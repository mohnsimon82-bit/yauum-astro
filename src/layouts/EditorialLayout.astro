---
import Analytics from "../components/Analytics.astro";
import ContactIntentTracking from "../components/ContactIntentTracking.astro";
import SeoMeta from "../components/SeoMeta.astro";
import scriptSite from "../scripts/editorial/site.js?raw";
import scriptScrollRestore from "../scripts/editorial/scroll-restore.js?raw";
import SiteChromeTop from "../components/chrome/SiteChromeTop.astro";
import SiteChromeFooter from "../components/chrome/SiteChromeFooter.astro";
import { canonicalUrl, type SeoData } from "../lib/seo";
import "../styles/fonts.css";
import "../styles/site-chrome.css";

interface Props {
  /** 统一 SEO 数据，取自 src/lib/seo.ts 的 SEO 映射 */
  seo: SeoData;
  variant?: "home" | "product";
  navCurrent?: string[];
}

const {
  seo,
  variant = "product",
  navCurrent = [],
} = Astro.props;

const canonical = canonicalUrl(seo);
const mainId = variant === "home" ? "main" : "main-content";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={canonical} />
    {seo.noindex && <meta name="robots" content="noindex, nofollow" />}
    <SeoMeta seo={seo} />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {seo.jsonLd?.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <Analytics />
    <ContactIntentTracking />
  </head>
  <body>
    <SiteChromeTop
      mainId={mainId}
      navCurrent={navCurrent}
    />

<main id={mainId}>
      <slot />
    </main>

    <SiteChromeFooter navCurrent={navCurrent} />

<script is:inline set:html={scriptSite} />
{variant === "home" && <script is:inline set:html={scriptScrollRestore} />}
  </body>
</html>
