---
import Analytics from "../components/Analytics.astro";
import scriptSite from "../scripts/editorial/site.js?raw";
import scriptScrollRestore from "../scripts/editorial/scroll-restore.js?raw";
import SiteChromeTop from "../components/chrome/SiteChromeTop.astro";
import SiteChromeFooter from "../components/chrome/SiteChromeFooter.astro";
import "../styles/site-chrome.css";

interface Props {
  title: string;
  description: string;
  canonical: string;
  jsonLd?: Record<string, unknown>[];
  variant?: "home" | "product";
  navCurrent?: string[];
  showMobileInquiry?: boolean;
}

const {
  title,
  description,
  canonical,
  jsonLd,
  variant = "product",
  navCurrent = [],
  showMobileInquiry = false,
} = Astro.props;

const mainId = variant === "home" ? "main" : "main-content";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600&family=Roboto+Mono:wght@500&family=Roboto:wght@400;500;600&display=swap" />
    {jsonLd?.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <Analytics />
  </head>
  <body>
    <SiteChromeTop
      mainId={mainId}
      navCurrent={navCurrent}
      showMobileInquiry={showMobileInquiry}
    />

<main id={mainId}>
      <slot />
    </main>

    <SiteChromeFooter navCurrent={navCurrent} />

<script is:inline set:html={scriptSite} />
{variant === "home" && <script is:inline set:html={scriptScrollRestore} />}
  </body>
</html>
