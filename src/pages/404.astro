---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSeo } from "../lib/seo";
---

<BaseLayout seo={getSeo("/404/")}>
  <section class="not-found shell">
    <p class="eyebrow eyebrow-dark"><span></span> 404</p>
    <h1>This Page Is Not on the Production Line.</h1>
    <p>Return to the homepage or send us your product requirements.</p>
    <a class="button button-dark" href="/">Back to homepage</a>
  </section>
</BaseLayout>
