---
/** 
 * production（V2 家族版式，2026-10-11 起）。
 *
 * 由终审定稿的预览成品移植：production-完整版.html
 * （07-开发分析与临时产物/首页v2-配图预览-2026-10-10/）。
 * 版式与文案逐字保留；页头/页脚改用共享 chrome 组件（V2Layout，其样式在页面
 * CSS 的「全局页头/页脚样式（绿色→紫罗兰映射）」段）；询盘表单保留原标记，
 * 接线换成真实投递链路（action=/api/inquiry + InquirySubmitScript）；SEO 文案
 * 取自 src/lib/seo.ts 的同路径条目，与旧版逐字一致（面包屑 / 内链 / 原文经
 * 全站终审核对）。页面级样式：src/styles/pages/production.css。
 */
import V2Layout from "../layouts/V2Layout.astro";
import { getSeo } from "../lib/seo";
import "../styles/pages/production.css";
---

<V2Layout seo={getSeo("/production/")} navCurrent={["/production/"]}>
<!-- HERO -->
<section class="hero" id="hero">
  <div class="hero-media">
    <img src="/uploads/production/hero-custom-clothing-category-range.webp" alt="Hoodie, T-shirt, jacket, pants, tracksuit, and printed sweatshirt shown as finished-garment references" width="1920" height="1080" />
  </div>
  <div class="container hero-inner">
    <span class="eyebrow">Production workflow</span>
    <h1>Custom Clothing Manufacturing From Brief to Bulk Order</h1>
    <p class="lead">Hoodies, T-shirts, jackets, pants, sportswear, and streetwear move through the same reviewed production path — confirmed brief, approved sample, and evidence you can request at every stage.</p>
    <p><a class="btn btn-primary" href="/contact-us/">Send a project brief <span class="arrow">&rarr;</span></a></p>
    <p class="hero__caption">Supplied finished-garment reference · materials and specifications require confirmation</p>
  </div>
</section>

<!-- §01 PRODUCTION PROCESS -->
<section class="section s01" id="production-process">
  <div class="container">
    <div class="s01__head reveal">
      <span class="eyebrow">01 / Production process</span>
      <h2>Custom Clothing Production Process</h2>
      <p class="lead">A custom order moves through five confirmed stages, from brief to packed garment — each stage locks in what the next one builds on.</p>
    </div>
    <div class="line reveal" role="list" aria-label="Five confirmed production stages">
      <div class="line__col" role="listitem">
        <div class="line__numrow"><span class="line__dot" aria-hidden="true"></span><span class="line__num">01</span></div>
        <h3>Product Brief Review</h3>
        <p>Garment type, quantity, reference photos or a tech pack, target sizes, fabric direction, color, and label files — enough to give both sides a shared starting point.</p>
      </div>
      <div class="line__col" role="listitem">
        <div class="line__numrow"><span class="line__dot" aria-hidden="true"></span><span class="line__num">02</span></div>
        <h3>Specification and Tech Pack</h3>
        <p>Fabric weight, trims, stitching, printing, embroidery, labels, and packaging get confirmed together, turning the brief into a spec the factory floor can build from.</p>
      </div>
      <div class="line__col" role="listitem">
        <div class="line__numrow"><span class="line__dot" aria-hidden="true"></span><span class="line__num">03</span></div>
        <h3>Sample Development and Review</h3>
        <p>A sample is made and checked against that spec — fit, measurements, construction, and look. Lead time, cost, and revision rounds are confirmed per project. Only an approved sample becomes the bulk reference.</p>
      </div>
      <div class="line__col" role="listitem">
        <div class="line__numrow"><span class="line__dot" aria-hidden="true"></span><span class="line__num">04</span></div>
        <h3>Bulk Production</h3>
        <p>Cutting, sewing, finishing, and decoration follow the approved sample. Progress photos can be requested during this stage.</p>
      </div>
      <div class="line__col" role="listitem">
        <div class="line__numrow"><span class="line__dot" aria-hidden="true"></span><span class="line__num">05</span></div>
        <h3>Final Check and Packing</h3>
        <p>Finished garments are checked against the approved sample, then labeled, folded, bagged, and packed. Inspection and packing records are available on request.</p>
      </div>
    </div>
  </div>
</section>

<!-- §02 PRODUCT CATEGORIES -->
<section class="section s02" id="product-categories">
  <div class="container">
    <div class="s02__head reveal">
      <span class="eyebrow">02 / Product categories</span>
      <h2>Apparel Categories We Manufacture</h2>
      <p class="lead">Six core categories move through this process, each with its own page for fit, fabric, and construction detail.</p>
    </div>
    <div class="cat-grid reveal">
      <a class="cat-card" href="/hoodie-manufacturer/">
        <div class="cat-media"><img src="/uploads/products/hoodie-manufacturer.jpg" alt="Hoodie Manufacturer product reference" width="600" height="800" /></div>
        <span class="cat-num">01</span>
        <span class="cat-name">Hoodie</span>
        <p class="cat-desc">Hoodie programs developed through fit, fabric, construction, decoration, labels, sample approval, and pack-out planning.</p>
        <span class="cat-link">View manufacturing page <span class="cat-arrow">&rarr;</span></span>
      </a>
      <a class="cat-card" href="/t-shirt-manufacturer/">
        <div class="cat-media"><img src="/uploads/products/t-shirt-manufacturer.jpg" alt="T-Shirt Manufacturer product reference" width="600" height="800" /></div>
        <span class="cat-num">02</span>
        <span class="cat-name">T-Shirt</span>
        <p class="cat-desc">T-shirts defined through silhouette, fabric weight, measurements, artwork, labels, and sample approval before bulk references are set.</p>
        <span class="cat-link">View manufacturing page <span class="cat-arrow">&rarr;</span></span>
      </a>
      <a class="cat-card" href="/jackets-manufacturer/">
        <div class="cat-media"><img src="/uploads/products/jackets-manufacturer.jpg" alt="Jackets Manufacturer product reference" width="600" height="800" /></div>
        <span class="cat-num">03</span>
        <span class="cat-name">Jackets</span>
        <p class="cat-desc">Jackets coordinated through shell, lining, insulation, closures, trims, branding, sampling, and packing requirements.</p>
        <span class="cat-link">View manufacturing page <span class="cat-arrow">&rarr;</span></span>
      </a>
      <a class="cat-card" href="/pants-manufacturer/">
        <div class="cat-media"><img src="/uploads/products/pants-manufacturer.jpg" alt="Pants Manufacturer product reference" width="600" height="800" /></div>
        <span class="cat-num">04</span>
        <span class="cat-name">Pants</span>
        <p class="cat-desc">Pants planned around fit blocks, fabric, pockets, waist construction, hardware, finishing, branding, and approved measurements.</p>
        <span class="cat-link">View manufacturing page <span class="cat-arrow">&rarr;</span></span>
      </a>
      <a class="cat-card" href="/sportswear-manufacturer/">
        <div class="cat-media"><img src="/uploads/products/sportswear-manufacturer.jpg" alt="Sportswear Manufacturer product reference" width="600" height="800" /></div>
        <span class="cat-num">05</span>
        <span class="cat-name">Sportswear</span>
        <p class="cat-desc">Sportswear reviewed through performance fabric direction, stretch, construction, artwork, labels, fit, and sample approval.</p>
        <span class="cat-link">View manufacturing page <span class="cat-arrow">&rarr;</span></span>
      </a>
      <a class="cat-card" href="/streetwear-manufacturer/">
        <div class="cat-media"><img src="/uploads/products/streetwear-manufacturer.jpg" alt="Streetwear Manufacturer product reference" width="600" height="800" /></div>
        <span class="cat-num">06</span>
        <span class="cat-name">Streetwear</span>
        <p class="cat-desc">Streetwear built through silhouette, material, decoration, private labels, sampling, and pack-out rules.</p>
        <span class="cat-link">View manufacturing page <span class="cat-arrow">&rarr;</span></span>
      </a>
    </div>

    <div class="s02__floor reveal">
      <div class="floor__head">
        <h4>From the Production Floor</h4>
        <p>Photos from the supplied production environment — shown as evidence of the work itself, not a claim about ownership, scale, or certification. Work is checked against the sample both sides have already approved.</p>
      </div>
      <div class="photo-wall">
        <figure class="photo feature">
          <img src="/uploads/factory/factory-sewing-line-wide.webp" alt="Wide view of a garment sewing line with operators and workstations" width="1600" height="900" />
          <figcaption class="caption"><span class="cap-num">01</span><span>Sewing line</span></figcaption>
        </figure>
        <figure class="photo">
          <img src="/uploads/factory/factory-pattern.webp" alt="Pattern preparation and garment construction work in the supplied production environment" width="800" height="600" />
          <figcaption class="caption"><span class="cap-num">02</span><span>Pattern preparation</span></figcaption>
        </figure>
        <figure class="photo">
          <img src="/uploads/factory/factory-cutting.webp" alt="Fabric cutting table and cutting equipment in the supplied production environment" width="800" height="600" />
          <figcaption class="caption"><span class="cap-num">03</span><span>Fabric cutting</span></figcaption>
        </figure>
        <figure class="photo">
          <img src="/uploads/factory/factory-printing.webp" alt="Garment printing equipment and operators in the supplied production environment" width="800" height="600" />
          <figcaption class="caption"><span class="cap-num">04</span><span>Printing and decoration</span></figcaption>
        </figure>
        <figure class="photo">
          <img src="/uploads/factory/factory-showroom.webp" alt="Garment sample showroom with apparel on display" width="800" height="600" />
          <figcaption class="caption"><span class="cap-num">05</span><span>Sample showroom</span></figcaption>
        </figure>
        <figure class="photo">
          <img src="/uploads/factory/factory-packout.webp" alt="Finished garments being folded and prepared for packing" width="800" height="600" />
          <figcaption class="caption"><span class="cap-num">06</span><span>Pack-out preparation</span></figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

<!-- §03 IMPORTANT NOTE -->
<section class="section s03" id="important-note">
  <div class="s03__block reveal">
    <span class="eyebrow">03 / Important note</span>
    <div class="note-grid">
      <h2>Important Note</h2>
      <p class="note-body">Timelines for sampling and bulk production are confirmed for each project rather than quoted as a fixed number upfront, since they depend on the garment, complexity, quantity, decoration, and destination. The minimum order is 100 pieces per style, and colors and sizes within that style can be mixed freely to reach the total.</p>
    </div>
  </div>
</section>

<!-- §04 FAQ -->
<section class="section s04" id="faq">
  <div class="container">
    <div class="s04__head reveal">
      <span class="eyebrow">04 / FAQ</span>
      <h2>FAQ</h2>
    </div>
    <div class="faq-list reveal">
      <div class="faq-row">
        <div class="faq-q"><span class="faq-num">01</span><h3>What Is the Minimum Order Quantity?</h3></div>
        <p class="faq-a">100 pieces per style, with colors and sizes inside that style free to mix to reach the total.</p>
      </div>
      <div class="faq-row">
        <div class="faq-q"><span class="faq-num">02</span><h3>Can I Combine Several Styles or Categories in One Inquiry?</h3></div>
        <p class="faq-a">Yes — send the full collection together and list quantities for each style. Each style still needs to reach its own 100-piece minimum; quantities don't combine across different styles or categories.</p>
      </div>
      <div class="faq-row">
        <div class="faq-q"><span class="faq-num">03</span><h3>Can You Work From My Own Fabric or Reference Sample?</h3></div>
        <p class="faq-a">Yes — reference photos, a tech pack, or a physical sample are all normal starting points, and fabric targets get confirmed alongside them at the specification stage.</p>
      </div>
      <div class="faq-row">
        <div class="faq-q"><span class="faq-num">04</span><h3>Can I Review a Sample Before Bulk Production?</h3></div>
        <p class="faq-a">Yes. A sample gets made and reviewed against the confirmed specification — fit, measurements, construction, fabric, and brand details — before it's approved as the reference for bulk.</p>
      </div>
      <div class="faq-row">
        <div class="faq-q"><span class="faq-num">05</span><h3>Can I Request Photos During Production and Inspection?</h3></div>
        <p class="faq-a">Yes. Photos, measurement records, and packing information can be requested at the sampling, production, inspection, and packing stages.</p>
      </div>
    </div>
  </div>
</section>

<!-- §05 START AN INQUIRY -->
<section class="section s05" id="start-an-inquiry">
  <div class="container">
    <div class="form-grid reveal">
      <div class="form-side">
        <span class="eyebrow">05 / Start an inquiry</span>
        <h2>Send the Product Details That Shape a Useful Review.</h2>
        <p><a class="btn btn-primary" href="/contact-us/">Send project details <span class="arrow">&rarr;</span></a></p>
      </div>
      <form method="POST" action="/api/inquiry" data-product="Production" data-wa-phone="8615733728976" data-wa-key="" class="inquiry-form" id="inquiry-form"><input type="hidden" name="product" value="Production" /><input type="hidden" name="_subject" value="Yauum inquiry — Production" /><input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />
        <div>
          <label for="garment">Garment type</label>
          <select class="select" id="garment" name="garment_type">
            <option value="Hoodies">Hoodies</option>
            <option value="T-Shirts">T-Shirts</option>
            <option value="Jackets">Jackets</option>
            <option value="Pants">Pants</option>
            <option value="Sportswear">Sportswear</option>
            <option value="Streetwear">Streetwear</option>
            <option value="Other" selected>Other</option>
          </select>
        </div>
        <div>
          <div class="opt-legend"><span>Quantity</span><span>&middot; 1 design &middot; 1 color &middot; 5 sizes</span></div>
          <div class="opt-row" role="radiogroup" aria-label="Quantity">
            <label><input type="radio" name="moq_tier" value="100–500 pcs" checked /><span>100&ndash;500 pcs</span></label>
            <label><input type="radio" name="moq_tier" value="500–1,000 pcs" /><span>500&ndash;1,000 pcs</span></label>
            <label><input type="radio" name="moq_tier" value="1,000–2,000 pcs" /><span>1,000&ndash;2,000 pcs</span></label>
            <label><input type="radio" name="moq_tier" value="2,000+ pcs" /><span>2,000+ pcs</span></label>
          </div>
        </div>
        <div>
          <label for="name">Name</label>
          <input class="input" id="name" name="name" type="text" required />
        </div>
        <div>
          <label for="email">Email</label>
          <input class="input" id="email" name="email" type="email" required />
        </div>
        <div>
          <label for="details">Project details (optional)</label>
          <textarea class="textarea" id="details" name="message"></textarea>
        </div>
        <p><button type="submit" class="btn btn-primary">Send inquiry <span class="arrow">&rarr;</span></button></p>
        <p class="form-status" id="form-status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>
  <Fragment slot="scripts">
    <script is:inline>(function () {
  var els = document.querySelectorAll('.reveal');
  if (!('IntersectionObserver' in window)) {
    els.forEach(function (e) { e.classList.add('in'); });
    return;
  }
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (en) {
      if (en.isIntersecting) {
        en.target.classList.add('in');
        io.unobserve(en.target);
      }
    });
  }, { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });
  els.forEach(function (e) { io.observe(e); });
})();</script>
  </Fragment>
</V2Layout>
