---
/**
 * /contact-us/（V2 家族版式，2026-10-11 起）。
 *
 * 由动态路由 [...slug].astro（旧 ContentPage）迁移为独立页面文件：文案与旧版
 * 逐字一致（经全站终审核对），版式换成 V2 家族体系（深色 hero → 编号清单 →
 * 暖色注记 → 询盘区）。询盘表单为真实投递链路（POST /api/inquiry，
 * product="Contact Us"，脚本由 V2Layout 注入）。
 * 页面样式：src/styles/pages/contact-us.css（家族底座 + 本页附录）。
 */
import V2Layout from "../layouts/V2Layout.astro";
import V2Inquiry from "../components/V2Inquiry.astro";
import { getSeo } from "../lib/seo";
import "../styles/pages/contact-us.css";
---

<V2Layout seo={getSeo("/contact-us/")} navCurrent={[]}>
  <section class="hero">
    <div class="container">
      <span class="eyebrow">Start an inquiry</span>
      <h1>Send the Details That Shape a Useful Manufacturing Review</h1>
      <p class="lead">A product name alone is not enough. Prepare the information below so fabric, construction, sampling, branding, packing, and delivery needs can be reviewed together</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="sec-head">
        <div class="sec-head__main">
          <p class="section-eyebrow"><span class="num">01</span> / Contact Us</p>
          <h2 class="section-h2">Your First Product Brief Should Answer Eight Questions</h2>
        </div>
        <div class="sec-head__note"><p class="section-lead">You can start with a tech pack, reference photos, a physical sample, or a clear product direction</p></div>
      </div>
      <div class="m-list">
        <div class="m-list__row"><span class="num">01</span><h3 class="section-h3">Product and Quantity</h3><p>Category, style direction, colorways, size range, and estimated order quantity</p></div>
        <div class="m-list__row"><span class="num">02</span><h3 class="section-h3">References</h3><p>Tech pack, product photos, sketches, artwork, measurements, or details from a physical sample</p></div>
        <div class="m-list__row"><span class="num">03</span><h3 class="section-h3">Fabric Target</h3><p>Composition, weight, color, handfeel, stretch, performance, or special material needs</p></div>
        <div class="m-list__row"><span class="num">04</span><h3 class="section-h3">Fit and Sizing</h3><p>Target market, fit preference, key measurements, grading notes, or an approved reference garment</p></div>
        <div class="m-list__row"><span class="num">05</span><h3 class="section-h3">Branding</h3><p>Logo files, print or embroidery direction, labels, trims, hangtags, stickers, and barcode inputs</p></div>
        <div class="m-list__row"><span class="num">06</span><h3 class="section-h3">Packing and Delivery</h3><p>Folding, bags, carton marks, destination, target timing, receiving, and document needs</p></div>
      </div>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container">
      <div class="sec-head">
        <div class="sec-head__main">
          <p class="section-eyebrow"><span class="num">02</span> / Important note</p>
          <h2 class="section-h2">Direct Contact Channels</h2>
        </div>
      </div>
      <p class="section-lead">WhatsApp: +86 157 3372 8976. Email: mumu@yauum.com. Send the product brief through the inquiry page, then use either channel for follow-up questions</p>
    </div>
  </section>

  <V2Inquiry
    product="Contact Us"
    kicker="03 / Start an inquiry"
    title="Send the Product Details That Shape a Useful Review"
  />
</V2Layout>
