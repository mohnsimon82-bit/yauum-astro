---
import ContentPage from "../components/ContentPage.astro";
import HoodieManufacturerPage from "../components/HoodieManufacturerPage.astro";
import JacketsManufacturerPage from "../components/JacketsManufacturerPage.astro";
import TShirtManufacturerPage from "../components/TShirtManufacturerPage.astro";
import PantsManufacturerPage from "../components/PantsManufacturerPage.astro";
import SportswearManufacturerPage from "../components/SportswearManufacturerPage.astro";
import StreetwearManufacturerPage from "../components/StreetwearManufacturerPage.astro";
import { getPageManifest, getWebsitePage } from "../lib/content";

export async function getStaticPaths() {
  const pages = await getPageManifest();
  return pages
    .filter(page => page.slug !== "home")
    .map(page => ({ params: { slug: page.route.replace(/^\/+|\/+$/g, "") }, props: { pageSlug: page.slug } }));
}

const { pageSlug } = Astro.props;
const page = await getWebsitePage(pageSlug);
const productSlugs = [
  "hoodie-manufacturer",
  "t-shirt-manufacturer",
  "jackets-manufacturer",
  "pants-manufacturer",
  "sportswear-manufacturer",
  "streetwear-manufacturer",
];
const products = productSlugs.includes(pageSlug)
  ? await Promise.all(productSlugs.map(getWebsitePage))
  : [];
---

{pageSlug === "hoodie-manufacturer"
  ? <HoodieManufacturerPage />
  : pageSlug === "t-shirt-manufacturer"
    ? <TShirtManufacturerPage page={page} />
  : pageSlug === "jackets-manufacturer"
    ? <JacketsManufacturerPage page={page} />
  : pageSlug === "pants-manufacturer"
    ? <PantsManufacturerPage page={page} />
  : pageSlug === "sportswear-manufacturer"
    ? <SportswearManufacturerPage page={page} />
  : pageSlug === "streetwear-manufacturer"
    ? <StreetwearManufacturerPage page={page} />
  : <ContentPage page={page} products={products} />}
