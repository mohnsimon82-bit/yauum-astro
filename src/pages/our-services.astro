---
/**
 * /our-services/ 专属页面。
 *
 * 背景：该页面原先由 src/components/ContentPage.astro（动态路由 [...slug].astro）
 * 渲染，而 ContentPage 同时服务 about-us / blog / contact-us / solutions。
 * 为了让本次改版不影响其他页面，our-services 独立成页面文件，
 * 并在 [...slug].astro 的过滤条件中排除（写法与 production 相同）。
 *
 * 复用 global.css 的共享类（standard-hero / section / section-surface / shell /
 * section-head / kicker / standard-note-section）；H3 区块、Hero 两栏布局与图片占位符
 * 沿用产品页的 .sw-grid / .sw-block / .sw-ph 命名与规则，复制在 our-services.css 里。
 * 设计令牌未做任何改动。Hero 保持现网结构（kicker + H1 + 正文 + CTA），
 * 本次在文案右侧补一个 Hero 图占位符（.sw-ph--hero）。
 *
 * 锚点与传参：InquirySection 的 product="Our Services" 与 id="inquiry" 保持不变。
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import InquirySection from "../components/InquirySection.astro";
import { getSeo } from "../lib/seo";
import "../styles/pages/our-services.css";

type Block = {
  /** H3 标题 */
  title: string;
  /** 占位符要补的图片主题（显示在占位符标题行） */
  tag: string;
  /** H3 正文，按行拆分（多数为一行；06 区是 Share / Next focus 两行） */
  lines: string[];
  /** 占位符 aria-label：写清要补的是哪种照片 */
  aria: string;
};

type Section = {
  num: string;
  kicker: string;
  title: string;
  intro: string;
  blocks: Block[];
};

const sections: Section[] = [
  {
    num: "01",
    kicker: "01 / Product development and sampling",
    title: "Product Development and Sampling",
    intro: "Every order starts here — turning a brief into a confirmed specification, then into an approved sample both sides can build bulk production from.",
    blocks: [
      {
        title: "Brief and Reference Review",
        tag: "Reference Materials and Brief Intake",
        lines: [
          "A project starts with what you already have: a tech pack, reference photos, a physical sample, fabric targets, size range, label files, quantity, packaging needs, target market, and timing. None of it needs to be complete — it just needs to give both sides a shared starting point.",
        ],
        aria: "Placeholder for a photo showing reference materials and brief intake, such as a tech pack or reference sample review.",
      },
      {
        title: "Specification Confirmation",
        tag: "Specification and Trim Confirmation",
        lines: [
          "Trims, stitching, printing, embroidery, labels, and packaging get checked and confirmed together, turning the brief into a specification the factory floor can build from.",
        ],
        aria: "Placeholder for a photo showing specification and trim confirmation in progress.",
      },
      {
        title: "Sample Development and Fit Review",
        tag: "Sample Fit and Measurement Review",
        lines: [
          "A sample is made and reviewed against your brief — fit, measurements, construction, and overall look checked against your reference or size range. Lead time, cost, and revision rounds are confirmed per project rather than quoted as a fixed number upfront.",
        ],
        aria: "Placeholder for a photo showing sample fit and measurement review.",
      },
      {
        title: "Sample Approval",
        tag: "Approved Sample Reference",
        lines: [
          "Comments get documented against the sample and revisions made before it's approved. Only an approved sample is used as the reference for bulk production.",
        ],
        aria: "Placeholder for a photo showing the approved sample used as the bulk reference.",
      },
    ],
  },
  {
    num: "02",
    kicker: "02 / Fabrics and materials",
    title: "Fabrics and Materials",
    intro: "Fabric decisions get locked in alongside the specification, not left until production starts.",
    blocks: [
      {
        title: "Fabric and Composition Confirmation",
        tag: "Fabric and Composition Reference",
        lines: [
          "Fabric composition, weight, and construction are reviewed against your brief and confirmed before the specification is finalized, so the sample is built from the same target as the bulk order.",
        ],
        aria: "Placeholder for a photo showing fabric and composition reference materials.",
      },
      {
        title: "Color and Handfeel Matching",
        tag: "Color and Handfeel Swatch Match",
        lines: [
          "Color and handfeel are matched against your reference or swatch at the specification stage. The approved reference becomes the standard that bulk fabric is checked against.",
        ],
        aria: "Placeholder for a photo showing color and handfeel swatch matching.",
      },
    ],
  },
  {
    num: "03",
    kicker: "03 / Printing and decoration",
    title: "Printing and Decoration",
    intro: "Decoration gets planned around your artwork and the garment itself, confirmed before it reaches the sample stage.",
    blocks: [
      {
        title: "Artwork and Placement Confirmation",
        tag: "Artwork and Placement Check",
        lines: [
          "Artwork files, placement, and sizing are confirmed against the garment before any decoration method is applied.",
        ],
        aria: "Placeholder for a photo showing artwork and placement confirmation on the garment.",
      },
      {
        title: "Decoration Technique Matching",
        tag: "Decoration Technique Sample",
        lines: [
          "The decoration approach is matched to your artwork and the garment's fabric, then confirmed at the specification stage so the sample reflects what bulk production will produce.",
        ],
        aria: "Placeholder for a photo showing a decoration technique sample matched to the artwork.",
      },
    ],
  },
  {
    num: "04",
    kicker: "04 / Private label and packaging",
    title: "Private Label and Packaging",
    intro: "Brand details are specified down to the label, tag, and carton.",
    blocks: [
      {
        title: "Labels and Trim Options",
        tag: "Label and Trim Options",
        lines: [
          "Woven labels, neck labels, size labels, care labels, hang tags, stickers, and barcodes are specified according to each project's requirements.",
        ],
        aria: "Placeholder for a photo showing label and trim options such as woven labels, hang tags, and care labels.",
      },
      {
        title: "Packaging and Carton Marking",
        tag: "Packaging and Carton Marking",
        lines: ["Packaging bags and carton marks are specified to match your brand and shipping requirements."],
        aria: "Placeholder for a photo showing packaging bags and carton marking.",
      },
    ],
  },
  {
    num: "05",
    kicker: "05 / Quality inspection",
    title: "Quality Inspection",
    intro: "Quality gets checked against the approved sample, not a generic external standard.",
    blocks: [
      {
        title: "Comparison Against the Approved Sample",
        tag: "Sample Comparison Check",
        lines: [
          "Only a sample both sides have signed off on is used as the reference for checks during and after production, so there's something concrete to compare against rather than a general description.",
        ],
        aria: "Placeholder for a photo showing a finished garment compared against the approved sample.",
      },
      {
        title: "Buyer-Requested Inspection Evidence",
        tag: "Inspection and Measurement Record",
        lines: [
          "Photos, measurement records, and packing information can be requested at the sampling, production, inspection, and packing stages.",
        ],
        aria: "Placeholder for a photo showing inspection and measurement record documentation.",
      },
    ],
  },
  {
    num: "06",
    kicker: "06 / What you can start with",
    title: "What You Can Start With",
    intro: "Wherever your project is right now, there's a next step.",
    blocks: [
      {
        title: "I Have an Idea or Reference",
        tag: "Reference Image or Sketch Intake",
        lines: [
          "Share: garment type, reference images, and the fit or details you want to change.",
          "Next focus: defining the specification and sample brief.",
        ],
        aria: "Placeholder for a photo showing a reference image or sketch used to start a project.",
      },
      {
        title: "I Have a Tech Pack or Sample",
        tag: "Tech Pack and Sample Review",
        lines: [
          "Share: measurements, fabric and trim specifications, artwork, and any questions or marked changes.",
          "Next focus: reviewing fit and construction before confirming the specification.",
        ],
        aria: "Placeholder for a photo showing a tech pack or sample under review.",
      },
      {
        title: "I Have an Approved Sample",
        tag: "Approved Sample Ready for Bulk",
        lines: [
          "Share: quantities by style, color, and size, plus branding, packing, and delivery requirements.",
          "Next focus: confirming order scope and moving into bulk production.",
        ],
        aria: "Placeholder for a photo showing an approved sample ready to move into bulk production.",
      },
    ],
  },
];

/** 占位符按全页顺序编号（01–15），编号只用于标识待补素材，不进入正文语义 */
let placeholder = 0;
const withNumbers = sections.map((section) => ({
  ...section,
  blocks: section.blocks.map((block) => ({
    ...block,
    index: String(++placeholder).padStart(2, "0"),
  })),
}));
---

<BaseLayout seo={getSeo("/our-services/")}>
  {/* Hero —— 结构保持现网（kicker + H1 + 正文 + CTA）；桌面端文案在左、Hero 图占位符在右，
      窄屏堆叠到正文下方。Hero 图是本次唯一不在 01–15 编号序列里的占位符。 */}
  <section class="standard-hero os-hero">
    <div class="industrial-grid" aria-hidden="true"></div>
    <div class="shell standard-hero-inner">
      <p class="kicker kicker-accent">B2B apparel services</p>
      <h1>Custom Apparel Manufacturing Services for Your Brand</h1>
      <p>From product brief to pack-out, Yauum organizes manufacturing around the decisions buyers need to make before bulk production.</p>
      <a class="button button-accent" href="/contact-us/">Send a project brief</a>

      <div class="sw-ph sw-ph--hero" aria-label="Placeholder for a hero image showing finished apparel from the reviewed services workflow." data-evidence-status="needs_company_confirmation">
        <div class="sw-ph-media"><span class="sw-ph-tag">Hero / Required</span></div>
        <div class="sw-ph-copy">
          <strong>Hero Apparel Image</strong>
          <small>Recommended 1600 × 1200</small>
        </div>
      </div>
    </div>
  </section>

  {/* 01–06：每个 H2 一节，节内每个 H3 正文下面配一个单图占位符 */}
  {withNumbers.map((section, sectionIndex) => (
    <section class:list={["section", sectionIndex % 2 === 0 && "section-surface"]}>
      <div class="shell">
        <div class="section-head">
          <div><p class="kicker">{section.kicker}</p><h2 class="section-title">{section.title}</h2></div>
          <p>{section.intro}</p>
        </div>
        <div class="sw-grid sw-grid--2">
          {section.blocks.map((block) => (
            <article class="sw-block">
              <span class="sw-num">{section.num} / {block.index}</span>
              <h3>{block.title}</h3>
              {block.lines.map((line) => <p>{line}</p>)}
              <div class="sw-ph" aria-label={block.aria} data-evidence-status="needs_company_confirmation">
                <div class="sw-ph-media"><span class="sw-ph-tag">{block.index} / Required</span></div>
                <div class="sw-ph-copy">
                  <strong>{block.tag}</strong>
                  <small>Recommended 1600 × 1200</small>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  {/* 07 / Important note —— 原文保持不变 */}
  <section class="section standard-note-section">
    <div class="shell standard-note">
      <div><p class="kicker">07 / Important note</p><h2 class="section-title">The Final Scope Depends on the Confirmed Product.</h2></div>
      <p>The final scope depends on the confirmed product — MOQ, price, lead time, material availability, inspection method, and delivery plan are reviewed after the product requirements are clear.</p>
    </div>
  </section>

  {/* 08 / Start an inquiry —— data-product 传参链路保持不变 */}
  <InquirySection
    product="Our Services"
    id="inquiry"
    odId="inquiry-conversion"
    band="band-alt"
    kicker="08 / Start an inquiry"
    title="Send the Product Details That Shape a Useful Review."
    ctaLabel="Send project details"
  />
</BaseLayout>
